var peopleMode = 'member';
var teamFilter = '2026';

function setPeopleMode(m) {
  peopleMode = m;
  if ($('memMode')) $('memMode').hidden = (m !== 'member');
  if ($('teamMode')) $('teamMode').hidden = (m !== 'team');
  var btns = document.querySelectorAll('#segPeople button');
  if (btns[0]) btns[0].classList.toggle('on', m === 'member');
  if (btns[1]) btns[1].classList.toggle('on', m === 'team');
  if (m === 'team') renderTeam(); else renderMem();
}

function setTeamYear(y) { teamFilter = y; renderTeam(); }

function renderTeam() {
  var years = ['2026', '2025', '2024'];
  $('fTeam').innerHTML = years.map(function (y) {
    return '<button class="f' + (y === teamFilter ? ' on' : '') +
      '" onclick="setTeamYear(\'' + y + '\')">' + y + ' 届</button>';
  }).join('');

  var list = TEAMS.filter(function (t) { return t.year === teamFilter; });
  $('fTeam').innerHTML += '<span class="cnt">共 ' + list.length + ' 支</span>';
  if (!list.length) {
    $('listTeam').innerHTML = '<div class="empty">这一届还没有登记团队</div>';
    return;
  }

  $('listTeam').innerHTML = list.map(function (t) {
    var avs = t.members.slice(0, 5).map(function (m, i) {
      return '<i style="background:' + avStyle(['lin','chen','su','wang','li','zhou','zhao'][i % 7]) + '">' +
        esc(m.n.charAt(0)) + '</i>';
    }).join('');
    return '<div class="team-card" onclick="openTeam(\'' + t.id + '\')">' +
      '<div class="tc-top">' +
        '<div class="tc-ico" style="background:' + t.cover + '">' + t.emoji + '</div>' +
        '<div class="tc-t"><b>' + esc(t.name) + '</b><span>' + esc(t.field) + ' · 负责人 ' + esc(t.lead) + '</span></div>' +
        '<span class="' + (t.hot ? 'badge-hot' : 'badge-ok') + '">' + (t.hot ? '招人中' : '已满员') + '</span>' +
      '</div>' +
      '<p class="tc-desc">' + esc(t.intro) + '</p>' +
      '<div class="tc-foot">' +
        '<div class="tc-avs">' + avs + '</div>' +
        '<span style="font-size:10.5px;color:var(--ink3)">' + t.members.length + ' 人 · ' + esc(t.open) + '</span>' +
      '</div>' +
    '</div>';
  }).join('');
}

function openTeam(id) {
  var t = TEAMS.filter(function (x) { return x.id === id; })[0];
  if (!t) return;

  var projs = t.projects.map(function (pid) {
    return PROJECTS.filter(function (p) { return p.id === pid; })[0];
  }).filter(Boolean);

  var h = '<div class="tm-head">' +
      '<div class="big" style="background:' + t.cover + '">' + t.emoji + '</div>' +
      '<div><b>' + esc(t.name) + '</b><span>' + t.year + ' 届 · ' + esc(t.field) + ' · ' + t.members.length + ' 人</span></div>' +
    '</div>' +
    '<p style="font-size:12.5px;line-height:1.78;color:var(--ink2);margin:0 0 14px">' + esc(t.intro) + '</p>' +
    '<div style="display:flex;gap:8px;margin-bottom:16px">' +
      '<div style="flex:1;background:#f7f8fc;border-radius:12px;padding:9px;text-align:center">' +
        '<b style="display:block;font-size:13px">' + esc(t.lead) + '</b>' +
        '<span style="font-size:10px;color:var(--ink3)">负责人</span></div>' +
      '<div style="flex:1;background:' + (t.hot ? '#eefaf3' : '#f7f8fc') + ';border-radius:12px;padding:9px;text-align:center">' +
        '<b style="display:block;font-size:12px;color:' + (t.hot ? '#0b7a4b' : '#5b6478') + '">' +
        (t.hot ? '招人中' : '已满员') + '</b>' +
        '<span style="font-size:10px;color:var(--ink3)">团队状态</span></div>' +
    '</div>' +
    '<div class="dsec" style="margin-top:0">团队成员</div>';

  h += t.members.map(function (m, i) {
    return '<div class="tm-row" onclick="openMember(\'' + esc(m.n) + '\',\'' + t.id + '\')">' +
      '<div class="av5" style="background:' + avStyle(['lin','chen','su','wang','li','zhou','zhao'][i % 7]) + '">' +
        esc(m.n.charAt(0)) + '</div>' +
      '<div class="tr"><b>' + esc(m.n) + '</b><span>' + esc(m.r) + ' · ' + esc(m.s) + '</span></div>' +
      '<span style="font-size:10.5px;color:var(--ink3)">详情 ›</span>' +
    '</div>';
  }).join('');

  h += '<div class="dsec">团队项目</div>';
  h += projs.length
    ? projs.map(function (p) {
        return '<div class="mini" style="margin:0 0 8px" onclick="closeSheet();setTimeout(function(){openProject(\'' + p.id + '\')},260)">' +
          '<div class="mico" style="background:' + p.cover + '">' + p.emoji + '</div>' +
          '<div class="mt"><b>' + esc(p.t) + '</b><span>' + p.y + ' · ' + esc(p.award) + '</span></div>' +
          '<span style="color:var(--brand);font-size:11px;font-weight:600">查看</span></div>';
      }).join('')
    : '<div class="empty" style="padding:18px 0">项目待录入</div>';

  h += '<button class="gate-btn" style="margin-top:18px" onclick="applyTeam(\'' + t.id + '\')">' +
    (t.hot ? '申请加入这个团队' : '这个团队已满员') + '</button>';

  $('sheetTitle').textContent = '团队档案';
  $('sheetBody').innerHTML = h;
  openSheet();
}

function applyTeam(id) {
  var t = TEAMS.filter(function (x) { return x.id === id; })[0];
  if (!t) return;
  if (!t.hot) return toast('这个团队已经满员了，可以看看别的队');
  if (!S.applied) S.applied = [];
  var i = S.applied.indexOf(id);
  if (i >= 0) { S.applied.splice(i, 1); toast('已取消申请'); }
  else { S.applied.push(id); toast('已向「' + t.name + '」发出加入申请'); }
  save();
}

function openMember(name, fromTeamId) {
  var m = MEMBERS.filter(function (x) { return x.name === name; })[0];
  var teamName = '';
  var role = '';
  if (!m) {
    TEAMS.forEach(function (t) {
      t.members.forEach(function (mm) {
        if (mm.n === name && !teamName) { teamName = t.name; role = mm.r + ' · ' + mm.s; }
      });
    });
  }

  var h = '';
  if (fromTeamId) {
    h += '<button class="backbtn" onclick="openTeam(\'' + fromTeamId + '\')">‹ 返回团队</button>';
  }
  h += '<div class="tm-head">' +
      '<div class="big" style="background:' + avStyle(m ? m.av : 'lin') + ';font-size:20px;font-weight:700;color:#fff">' +
        esc(name.charAt(0)) + '</div>' +
      '<div><b>' + esc(name) + '</b><span>' + esc(m ? m.meta : (teamName + ' · ' + role)) + '</span></div>' +
    '</div>';

  if (m) {
    h += '<div class="give" style="margin-bottom:14px">' +
      '<div class="can"><b>可提供</b>' + esc(m.can) + '</div>' +
      '<div class="need"><b>需要</b>' + esc(m.need) + '</div></div>';
    h += '<div class="dsec" style="margin-top:0">技能标签</div>' +
      '<div class="dmember">' + m.skills.map(function (s) { return '<span>' + esc(s) + '</span>'; }).join('') + '</div>';
  }

  h += '<button class="gate-btn" style="margin-top:16px" onclick="closeSheet();setTimeout(function(){go(\'talk\')},300)">去交流广场找人</button>';

  $('sheetTitle').textContent = '成员名片';
  $('sheetBody').innerHTML = h;
  openSheet();
}

function goTeams() {
  go('people');
  setPeopleMode('team');
}

