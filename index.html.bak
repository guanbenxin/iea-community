    cover:'linear-gradient(135deg,#22c55e,#86efac)', field:'直播电商 · 供应链',
    intro:'对接本地农产品，做直播代运营和物流方案。',
    lead:'王砚', open:'招 1 人 · 主播', hot:false,
    members:[ {n:'王砚',r:'负责人',s:'运营'}, {n:'苏晴',r:'主播',s:'出镜'},
              {n:'李知远',r:'技术',s:'小程序'}, {n:'周明',r:'物流',s:'供应链'} ],
    projects:['p6'] },

