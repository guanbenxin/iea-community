var histYear = '2026';

function setHist(y) { histYear = y; renderHistory(); }

function hideTip() {
  var t = $('histTip');
  if (t) t.classList.add('gone');
  try { localStorage.setItem('iea_tip_hist', '1'); } catch (e) {}
}

function openPhoto(key) {
  if (!PHOTOS[key]) return;
  $('sheetTitle').textContent = '活动照片';
  $('sheetBody').innerHTML = '<img src="' + PHOTOS[key] +
    '" style="width:100%;border-radius:14px;display:block">' +
    '<div style="font-size:11px;color:var(--ink3);margin-top:10px;line-height:1.7">' +
    '照片来源：安徽水利水电职业技术学院官网 / 安徽省教育厅</div>';
  openSheet();
}

function renderGallery() {
  var list = [
    { k:'gz', cap:'挑战杯国赛决赛现场' },
    { k:'tz', cap:'挑战杯省赛现场' },
    { k:'c1', cap:'校园环境' },
    { k:'c2', cap:'学院设施' },
    { k:'c3', cap:'校园美景' }
  ].filter(function (x) { return PHOTOS[x.k]; });
  var el = $('gallery');
  if (!el) return;
  el.innerHTML = list.map(function (x) {
    return '<div class="gcard" onclick="openPhoto(\'' + x.k + '\')">' +
      '<img src="' + PHOTOS[x.k] + '" alt="">' +
      '<span>' + esc(x.cap) + '</span></div>';
  }).join('');
}

function renderHistory() {
  $('fHist').innerHTML = COHORTS.map(function (c) {
    return '<button class="f' + (c.year === histYear ? ' on' : '') +
      '" onclick="setHist(\'' + c.year + '\')">' + c.year + ' 届</button>';
  }).join('');

  var c = COHORTS.filter(function (x) { return x.year === histYear; })[0];
  if (!c) { $('listHist').innerHTML = '<div class="empty">暂无数据</div>'; return; }

  var badge = c.real ? '' : '<span class="demoBadge">示例</span>';
  var h = '';

  if (PHOTOS[c.photo]) {
    h += '<div class="hhero" onclick="openPhoto(\'' + c.photo + '\')">' +
           '<img src="' + PHOTOS[c.photo] + '" alt="">' +
           '<div class="cap"><b>' + esc(c.headline) + badge + '</b>' +
           '<span>' + esc(c.caption) + '</span></div>' +
         '</div>';
  }

  h += '<div class="hstats">' + c.stats.map(function (s) {
    return '<div><b>' + esc(s.v) + '</b><span>' + esc(s.l) + '</span></div>';
  }).join('') + '</div>';

  h += '<div class="hsec">历届优秀会员' + badge + '</div>';
  h += c.stars.map(function (s, i) {
    return '<div class="star">' +
      '<div class="av4" style="background:' + avStyle(['lin','chen','su','wang','li','zhou'][i % 6]) + '">' +
        esc(s.name.charAt(0)) + '</div>' +
      '<div class="si"><b>' + esc(s.name) + '</b>' +
      '<span>' + esc(s.title) + ' · ' + esc(s.note) + '</span></div>' +
    '</div>';
  }).join('');

  h += '<div class="hsec">项目作品' + badge + '</div>';
  var ps = c.projects.map(function (id) {
    return PROJECTS.filter(function (p) { return p.id === id; })[0];
  }).filter(Boolean);
  if (!ps.length) h += '<div class="empty" style="padding:26px 0">该届项目待录入</div>';
  h += ps.map(function (p) {
    return '<div class="mini" onclick="openProject(\'' + p.id + '\')">' +
      '<div class="mico" style="background:' + p.cover + '">' + p.emoji + '</div>' +
      '<div class="mt"><b>' + esc(p.t) + '</b>' +
      '<span>' + p.y + ' · ' + esc(p.cat) + ' · ' + esc(p.award) + '</span></div>' +
      '<span style="color:var(--brand);font-size:11px;font-weight:600">查看</span>' +
    '</div>';
  }).join('');

  h += '<div class="hsec" style="margin-bottom:2px">获奖经历' + badge + '</div>';
  h += c.awards.map(function (a) {
    return '<div class="award">' +
      '<div class="bad"><b>' + esc(a.l) + '</b></div>' +
      '<div class="atxt">' + esc(a.t) + '<span>' + esc(a.d) + '</span></div>' +
    '</div>';
  }).join('');

  h += '<div style="height:22px"></div>';
  $('listHist').innerHTML = h;
}

var AV_COLORS = {
  lin:'linear-gradient(140deg,#6366f1,#8b5cf6)', chen:'linear-gradient(140deg,#f97316,#f43f5e)',
  su:'linear-gradient(140deg,#0ea5e9,#22c55e)', wang:'linear-gradient(140deg,#8b5cf6,#6366f1)',
  li:'linear-gradient(140deg,#f59e0b,#f97316)', zhao:'linear-gradient(140deg,#10b981,#0d9488)',
  zhou:'linear-gradient(140deg,#a855f7,#d946ef)'
};
var TYPE_COLOR = {
  '组队招募': 'background:#eef0fe;color:#4f46e5',
  '资源对接': 'background:#fff4ee;color:#a34b1c',
  '经验求助': 'background:#e9f9f1;color:#0b7a4b',
  '干货':     'background:#f3edff;color:#7c3aed'
};

/* ============================================================
   工具
   ============================================================ */
function esc(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function save() { saveJSON('iea_comm_v1', S); }
function avStyle(k) { return AV_COLORS[k] || 'linear-gradient(140deg,#6366f1,#a855f7)'; }

var toastTimer = null;
function toast(msg) {
  var el = $('toast');
  el.textContent = msg;
  el.classList.add('on');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function () { el.classList.remove('on'); }, 1800);
}

/* ============================================================
   导航
   ============================================================ */
var TITLES = { home:'创新创业学院', work:'成果长廊', talk:'交流广场', people:'成员与校友', doc:'活动与资料' };
var current = 'home';
var workMode = 'project';

function setWorkMode(m) {
  workMode = m;
  if ($('workModeProject')) $('workModeProject').hidden = (m !== 'project');
  if ($('workModeHistory')) $('workModeHistory').hidden = (m !== 'history');
  var b = document.querySelectorAll('#segWork button');
  if (b[0]) b[0].classList.toggle('on', m === 'project');
  if (b[1]) b[1].classList.toggle('on', m === 'history');
  if (current === 'work') $('topTitle').textContent = (m === 'history') ? '历届档案' : '成果长廊';
  if (m === 'history') renderHistory(); else renderWork();
}

function go(tab) {
  if (tab === 'history') tab = 'work';
  current = tab;
  ['home','work','talk','people','doc'].forEach(function (k) {
    $('v-' + k).classList.toggle('active', k === tab);
  });
  document.querySelectorAll('.tb').forEach(function (b) {
    b.classList.toggle('on', b.getAttribute('data-tab') === tab);
  });
  $('topTitle').textContent = TITLES[tab] || '';
  $('fab').classList.toggle('on', tab === 'talk');
  $('pages').scrollTop = 0;

  if (tab === 'work') renderWork();
  if (tab === 'talk') renderTalk();
  if (tab === 'people') setPeopleMode(peopleMode);
  if (tab === 'doc') renderDoc();

  try { history.replaceState(null, '', '#' + tab); } catch (e) {}
}

/* ============================================================
   成果
   ============================================================ */
var workFilter = '全部';
var workQuery = '';

function renderWork() {
  var cats = ['全部','国创','挑战杯','互联网+','校友创业'];
  $('fWork').innerHTML = cats.map(function (c) {
    return '<button class="f' + (c === workFilter ? ' on' : '') + '" onclick="setWorkFilter(\'' + c + '\')">' + c + '</button>';
  }).join('');

  var q = workQuery.trim().toLowerCase();
  var list = PROJECTS.filter(function (p) {
    if (workFilter !== '全部' && p.cat !== workFilter) return false;
    if (!q) return true;
    return (p.t + p.desc + p.tags.join('') + p.cat).toLowerCase().indexOf(q) >= 0;
  });

  $('fWork').innerHTML += '<span class="cnt">共 ' + list.length + ' 个</span>';

  if (!list.length) {
    $('listWork').innerHTML = '<div class="empty">没有匹配的项目<br>试试换个关键词或筛选条件</div>';
    return;
  }

  $('listWork').innerHTML = list.map(function (p) {
    return '' +
    '<div class="proj" onclick="openProject(\'' + p.id + '\')">' +
      '<div class="cover' + (p.photo && PHOTOS[p.photo] ? ' img' : '') + '" style="' +
        (p.photo && PHOTOS[p.photo]
          ? 'background-image:linear-gradient(180deg,rgba(15,23,42,.08),rgba(15,23,42,.60)),url(' + PHOTOS[p.photo] + ');background-size:cover;background-position:center'
          : 'background:' + p.cover) + '">' +
        (p.photo && PHOTOS[p.photo] ? '' : p.emoji) +
        '<span class="award">' + esc(p.award) + '</span>' +
        '<span class="yr">' + p.y + '</span>' +
      '</div>' +
      '<div class="pbody">' +
        '<h3>' + esc(p.t) + '</h3>' +
        '<p class="desc">' + esc(p.desc) + '</p>' +
        '<div class="tags">' + p.tags.map(function (t) { return '<span class="tag">' + esc(t) + '</span>'; }).join('') + '</div>' +
        '<div class="pfoot">' +
          '<div class="team">' +
            p.team.slice(0, 3).map(function (n) {
              return '<span class="avs" style="background:' + avStyle(avatarKey(n)) + '">' + esc(n.charAt(0)) + '</span>';
            }).join('') +
            '<span style="margin-left:7px">' + p.team.length + ' 人 · ' + esc(p.status) + '</span>' +
          '</div>' +
          '<span style="color:var(--brand);font-weight:600">看复盘 →</span>' +
        '</div>' +
      '</div>' +
    '</div>';
  }).join('');
}

function avatarKey(name) {
  var map = { '林小满':'lin','陈亦航':'chen','苏晴':'su','王砚':'wang','李知远':'li','赵敏':'zhao','周明':'zhou','王工':'wang' };
  return map[name] || 'lin';
}

function setWorkFilter(c) { workFilter = c; renderWork(); }

/* ============================================================
   生成「可复制到简历」的段落
   ============================================================ */
function myProjects() {
  return PROJECTS.filter(function (p) {
    return (p.team || []).indexOf(member.name) >= 0;
  });
}

function copyAllResume() {
  var list = myProjects();
  if (!list.length) return toast('你还没有关联的项目');
  copyText(list.map(resumeLine).join('\n\n'));
}
function resumeLine(p) {
  var nums = (p.nums || []).map(function (x) { return x.v + ' ' + x.l; }).join('、');
  var pt = ((p.points || [])[0] || '').slice(0, 64);
  return p.t + '（' + p.y + '，' + (p.cat || '') + '，' + (p.award || '') + '）\n' +
    '· 团队规模：' + ((p.team || []).length) + ' 人\n' +
    '· 核心工作：' + pt + '\n' +
    '· 量化成果：' + nums + '\n' +
    '· 项目状态：' + (p.status || '—');
}

function copyText(t) {
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(t)
      .then(function () { toast('已复制，可直接粘到简历里'); })
      .catch(function () { fallbackCopy(t); });
  } else {
    fallbackCopy(t);
  }
}

function fallbackCopy(t) {
  // 注意：节点要挂在 .app 里，不能挂 body —— 页面有清理逻辑会删掉 body 的直接子元素
  var host = document.querySelector('.app') || document.body;
  var ta = document.createElement('textarea');
  ta.value = t;
  ta.style.position = 'fixed';
  ta.style.left = '-9999px';
  ta.style.top = '0';
  host.appendChild(ta);
  ta.select();
  var ok = false;
  try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
  host.removeChild(ta);
  toast(ok ? '已复制，可直接粘到简历里' : '复制失败，请长按手动选择');
}

function copyResume(id) {
  var p = PROJECTS.filter(function (x) { return x.id === id; })[0];
  if (p) copyText(resumeLine(p));
}

function openProject(id) {
  var p = PROJECTS.filter(function (x) { return x.id === id; })[0];
  if (!p) return;

  $('sheetTitle').textContent = '项目复盘';
  $('sheetBody').innerHTML = '' +
    '<div class="dhero" style="' +
      (p.photo && PHOTOS[p.photo]
        ? 'background-image:url(' + PHOTOS[p.photo] + ');background-size:cover;background-position:center'
        : 'background:' + p.cover) + '">' +
      (p.photo && PHOTOS[p.photo] ? '' : p.emoji) + '</div>' +
    (p.photo && PHOTOS[p.photo]
      ? '<div style="font-size:10px;color:var(--ink3);margin:-6px 0 10px">配图 · 图源：学院官网 / 安徽省教育厅</div>'
      : '') +
    '<div style="display:flex;gap:6px;align-items:center;margin-bottom:8px">' +
      '<span style="font-size:10px;font-weight:700;color:#7a4b00;background:linear-gradient(180deg,#ffe9a8,#ffd166);padding:4px 9px;border-radius:99px">' + esc(p.award) + '</span>' +
      '<span style="font-size:11px;color:var(--ink3)">' + p.y + ' · ' + esc(p.cat) + ' · ' + esc(p.status) + '</span>' +
    '</div>' +
    '<h2 style="font-size:19px;margin:0 0 8px;letter-spacing:-.02em">' + esc(p.t) + '</h2>' +
    '<p style="font-size:12.5px;line-height:1.78;color:var(--ink2);margin:0">' + esc(p.desc) + '</p>' +
    '<div class="dnum">' +
      p.nums.map(function (n) { return '<div><b>' + esc(n.v) + '</b><span>' + esc(n.l) + '</span></div>'; }).join('') +
    '</div>' +
    '<div class="dsec">复盘要点</div>' +
    '<ul class="ulist">' + p.points.map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('') + '</ul>' +
    (p.fail
      ? '<div class="dsec">失败分析</div>' +
        '<div class="failBox">' +
          '<div class="frow"><b>为什么停</b><span>' + esc(p.fail.reason) + '</span></div>' +
          '<div class="frow"><b>关键失误</b><ul>' +
            p.fail.mistakes.map(function (m) { return '<li>' + esc(m) + '</li>'; }).join('') +
          '</ul></div>' +
          '<div class="frow"><b>如果重来</b><span>' + esc(p.fail.redo) + '</span></div>' +
          '<div class="fhint">' + esc(p.fail.advice) + '</div>' +
        '</div>'
      : '') +
    '<div class="dsec">团队成员</div>' +
    '<div class="dmember">' + p.team.map(function (n) { return '<span>' + esc(n) + '</span>'; }).join('') + '</div>' +
    '<div class="dsec">简历段落 · 可复制</div>' +
    '<div class="resumeBox">' + esc(resumeLine(p)) + '</div>' +
    '<button class="ghostbtn" style="margin-top:8px;color:var(--brand);border-color:#c9cbff;background:#f3f4ff" onclick="copyResume(\'' + p.id + '\')">复制这段到简历</button>' +
    '<button class="btn" style="width:100%;height:46px;border:0;border-radius:13px;margin-top:14px;background:linear-gradient(140deg,#6366f1,#8b5cf6);color:#fff;font-family:inherit;font-size:14px;font-weight:600;cursor:pointer" onclick="toast(\'已向团队发起资源对接申请\');closeSheet()">我想对接这个项目</button>';

  openSheet();
}

/* ============================================================
   交流
   ============================================================ */
var talkFilter = '全部';

function allPosts() {
  return S.userPosts.concat(SEED_POSTS);
}

function renderTalk() {
  var types = ['全部','组队招募','资源对接','经验求助','干货'];
  $('fTalk').innerHTML = types.map(function (t) {
    return '<button class="f' + (t === talkFilter ? ' on' : '') + '" onclick="setTalkFilter(\'' + t + '\')">' + t + '</button>';
  }).join('');

  var list = allPosts().filter(function (p) { return talkFilter === '全部' || p.type === talkFilter; });

  if (!list.length) {
    $('listTalk').innerHTML = '<div class="empty">这个板块还没有帖子<br>点右下角发起第一条</div>';
    return;
  }

  $('listTalk').innerHTML = list.map(function (p) {
    var liked = S.liked.indexOf(p.id) >= 0;
    var likes = p.likes + (liked ? 1 : 0);
    var cs = S.comments[p.id] || [];
    return '' +
    '<div class="post">' +
      '<div class="post-top">' +
        '<span class="av2" style="background:' + avStyle(p.av) + '">' + esc(p.author.charAt(0)) + '</span>' +
        '<div class="who"><b>' + esc(p.author) + '</b><span>' + esc(p.meta) + '</span></div>' +
        '<span class="ptype" style="' + (TYPE_COLOR[p.type] || TYPE_COLOR['干货']) + '">' + esc(p.type) + '</span>' +
      '</div>' +
      '<p>' + esc(p.text) + '</p>' +
      '<div class="pfoot2">' +
        '<button class="' + (liked ? 'liked' : '') + '" onclick="toggleLike(\'' + p.id + '\',event)">' +
          (liked ? '♥' : '♡') + ' ' + likes + '</button>' +
        '<button onclick="toggleComment(\'' + p.id + '\')">💬 ' + cs.length + '</button>' +
        '<span style="margin-left:auto">' + esc(p.time) + '</span>' +
      '</div>' +
      '<div class="cbox" id="cbox-' + p.id + '">' +
        '<input id="cin-' + p.id + '" placeholder="说点什么…" maxlength="120" onkeydown="if(event.key===\'Enter\')sendComment(\'' + p.id + '\')">' +
        '<button onclick="sendComment(\'' + p.id + '\')">发送</button>' +
      '</div>' +
      (cs.length ? '<div class="clist">' + cs.map(function (c) {
        return '<div><b>' + esc(c.who) + '：</b>' + esc(c.text) + '</div>';
      }).join('') + '</div>' : '') +
    '</div>';
  }).join('');
}

function setTalkFilter(t) { talkFilter = t; renderTalk(); }

function toggleLike(id, e) {
  if (e) e.stopPropagation();
  var i = S.liked.indexOf(id);
  if (i >= 0) S.liked.splice(i, 1); else S.liked.push(id);
  save();
  renderTalk();
}

function toggleComment(id) {
  var box = $('cbox-' + id);
  if (!box) return;
  box.classList.toggle('on');
  if (box.classList.contains('on')) {
    var inp = $('cin-' + id);
    if (inp) setTimeout(function () { inp.focus(); }, 50);
  }
}

function sendComment(id) {
  var inp = $('cin-' + id);
  if (!inp) return;
  var text = inp.value.trim();
  if (!text) return toast('先写点什么');
  if (!S.comments[id]) S.comments[id] = [];
  S.comments[id].push({ who: member.name, text: text });
  save();
  renderTalk();
  setTimeout(function () {
    var box = $('cbox-' + id);
    if (box) { box.classList.add('on'); var i2 = $('cin-' + id); if (i2) i2.focus(); }
  }, 30);
  toast('评论已发布');
}

/* 发帖 */
var composeType = '组队招募';

function openCompose() {
  composeType = '组队招募';
  $('sheetTitle').textContent = '发布帖子';
  $('sheetBody').innerHTML = '' +
    '<div class="dsec" style="margin-top:0">选择类型</div>' +
    '<div class="tpick" id="tpick">' +
      ['组队招募','资源对接','经验求助','干货'].map(function (t) {
        return '<button class="' + (t === composeType ? 'on' : '') + '" onclick="pickType(\'' + t + '\')">' + t + '</button>';
      }).join('') +
    '</div>' +
    '<div class="dsec" style="margin-top:4px">内容</div>' +
    '<textarea class="tarea" id="composeText" maxlength="300" placeholder="说明你要什么 / 能提供什么，越具体越容易有人回应…"></textarea>' +
    '<div class="tcount"><span id="cc">0</span>/300</div>' +
    '<button class="btn" style="width:100%;height:48px;border:0;border-radius:13px;margin-top:14px;background:linear-gradient(140deg,#6366f1,#8b5cf6);color:#fff;font-family:inherit;font-size:14px;font-weight:600;cursor:pointer" onclick="publish()">发布</button>';
  openSheet();
  setTimeout(function () {
    var ta = $('composeText');
    if (ta) {
      ta.focus();
      ta.addEventListener('input', function () { $('cc').textContent = ta.value.length; });
    }
  }, 80);
}

function pickType(t) {
  composeType = t;
  var box = $('tpick');
  if (!box) return;
  Array.prototype.forEach.call(box.children, function (b) {
    b.classList.toggle('on', b.textContent === t);
  });
}

function publish() {
  var ta = $('composeText');
  var text = ta ? ta.value.trim() : '';
  if (text.length < 5) return toast('内容太短了，至少 5 个字');

  S.userPosts.unshift({
    id: 'u' + Date.now(),
    type: composeType,
    author: member.name,
    meta: (member.cohort || '') + ' 级 · ' + (member.major || ''),
    av: 'lin',
    text: text,
    time: '刚刚',
    likes: 0
  });
  save();
  closeSheet();
  talkFilter = '全部';
  go('talk');
  toast('发布成功');
}

/* ============================================================
   成员
   ============================================================ */
var memFilter = '全部';
var memQuery = '';

function renderMem() {
  var types = ['全部','在校成员','校友','导师'];
  $('fMem').innerHTML = types.map(function (t) {
    return '<button class="f' + (t === memFilter ? ' on' : '') + '" onclick="setMemFilter(\'' + t + '\')">' + t + '</button>';
  }).join('');

  var q = memQuery.trim().toLowerCase();
  var list = MEMBERS.filter(function (m) {
    if (memFilter !== '全部' && m.type !== memFilter) return false;
    if (!q) return true;
    return (m.name + m.meta + m.can + m.need + m.skills.join('')).toLowerCase().indexOf(q) >= 0;
  });

  $('fMem').innerHTML += '<span class="cnt">共 ' + list.length + ' 人</span>';

  if (!list.length) {
    $('listMem').innerHTML = '<div class="empty">没找到这个人<br>换个关键词试试</div>';
    return;
  }

  $('listMem').innerHTML = list.map(function (m) {
    var greeted = S.greeted.indexOf(m.id) >= 0;
    return '' +
    '<div class="mem">' +
      '<div class="mem-top">' +
        '<span class="av3" style="background:' + avStyle(m.av) + '">' + esc(m.name.charAt(0)) + '</span>' +
        '<div class="info"><b>' + esc(m.name) + '</b><span>' + esc(m.meta) + '</span></div>' +
        '<button class="btn-sm ' + (greeted ? 'on' : '') + '" onclick="greet(\'' + m.id + '\')">' +
          (greeted ? '已打招呼' : '打招呼') + '</button>' +
      '</div>' +
      '<div class="give">' +
        '<div class="can"><b>可提供</b>' + esc(m.can) + '</div>' +
        '<div class="need"><b>需要</b>' + esc(m.need) + '</div>' +
      '</div>' +
    '</div>';
  }).join('');
}

function setMemFilter(t) { memFilter = t; renderMem(); }

function greet(id) {
  var i = S.greeted.indexOf(id);
  if (i >= 0) { S.greeted.splice(i, 1); toast('已取消'); }
  else { S.greeted.push(id); toast('已发送打招呼，对方会收到提醒'); }
  save();
  renderMem();
}

/* ============================================================
   资料
   ============================================================ */
var docFilter = '全部';

function renderDoc() {
  $('listAct').innerHTML = ACTIVITIES.map(function (a) {
    var joined = S.joined.indexOf(a.id) >= 0;
    return '' +
    '<div class="act">' +
      '<div class="when">' + esc(a.when) + '</div>' +
      '<b>' + esc(a.title) + '</b>' +
      '<p>' + esc(a.desc) + '</p>' +
      '<button class="join ' + (joined ? 'on' : '') + '" onclick="joinAct(\'' + a.id + '\')">' +
        (joined ? '已报名 ✓' : '立即报名') + '</button>' +
    '</div>';
  }).join('');

  var cats = ['全部'].concat(DOC_GROUPS.map(function (g) { return g.name; }));
  $('fDoc').innerHTML = cats.map(function (c) {
    return '<button class="f' + (c === docFilter ? ' on' : '') +
      '" onclick="setDocFilter(\'' + esc(c) + '\')">' + esc(c) + '</button>';
  }).join('');

  var groups = DOC_GROUPS.filter(function (g) {
    return docFilter === '全部' || g.name === docFilter;
  });
  var total = groups.reduce(function (a, g) { return a + g.items.length; }, 0);
  $('fDoc').innerHTML += '<span class="cnt">共 ' + total + ' 份</span>';

  $('listDoc').innerHTML = groups.map(function (g) {
    var rows = g.items.map(function (it, i) {
      var id = g.id + '-' + i;
      var n = S.downloads[id] || 0;
      return '<div class="doc-row" onclick="download(\'' + id + '\')">' +
        '<div class="dt"><b>' + esc(it.n) + '</b>' +
        '<span>' + esc(it.s || '') + (n ? ' · 已下载 ' + n + ' 次' : '') + '</span></div>' +
        '<span class="dl">下载</span>' +
      '</div>';
    }).join('');

    return '<div class="doc-group">' +
        '<div class="dg-head"><span class="dgi">' + g.ico + '</span>' +
        '<b>' + esc(g.name) + '</b>' +
        '<span class="dgc">' + g.items.length + ' 个</span></div>' +
        rows +
      '</div>';
  }).join('') || '<div class="empty">这个分类还没有资料</div>';
}

function setDocFilter(c) { docFilter = c; renderDoc(); }

function joinAct(id) {
  var i = S.joined.indexOf(id);
  if (i >= 0) { S.joined.splice(i, 1); toast('已取消报名'); }
  else { S.joined.push(id); toast('报名成功，活动前会提醒你'); }
  save();
  renderDoc();
}

function download(id) {
  S.downloads[id] = (S.downloads[id] || 0) + 1;
  save();
  renderDoc();
  toast('演示版：这里会触发真实文件下载');
}

/* ============================================================
   搜索
   ============================================================ */
function bindSearch(inputId, wrapId, kind) {
  var inp = $(inputId);
  var wrap = $(wrapId);
  inp.addEventListener('input', function () {
    var v = inp.value;
    wrap.classList.toggle('has', v.length > 0);
    if (kind === 'work') { workQuery = v; renderWork(); }
    if (kind === 'mem') { memQuery = v; renderMem(); }
  });
}

function clearSearch(kind) {
  if (kind === 'work') { workQuery = ''; $('qWork').value = ''; $('searchWork').classList.remove('has'); renderWork(); }
  if (kind === 'mem') { memQuery = ''; $('qMem').value = ''; $('searchMem').classList.remove('has'); renderMem(); }
}

/* ============================================================
   弹层
   ============================================================ */
function openSheet() {
  $('mask').classList.add('on');
  $('sheet').classList.add('on');
}
function closeSheet() {
  $('mask').classList.remove('on');
  $('sheet').classList.remove('on');
}

/* ============================================================
   初始化
   ============================================================ */
var booted = false;
function bootApp() {
  if (booted) return;
  booted = true;

  // 顶部身份
  meDefaults();
  $('meAv').textContent = member.name.charAt(0);
  $('meAv').style.background = avStyle(member.av);
  $('meName').textContent = member.name;
  $('hiText').textContent = '你好，' + member.name + ' · ' + (member.cohort || '') + ' 级';

  $('meBtn').onclick = function () {
    $('sheetTitle').textContent = '我的';
    $('sheetBody').innerHTML = '' +
      '<div class="member" style="margin:0 0 16px">' +
        '<div class="top">' +
          '<div class="av" style="background:' + avStyle('lin') + '">' + esc(member.name.charAt(0)) + '</div>' +
          '<div><b>' + esc(member.name) + '</b><span>' + esc(member.cohort || '') + ' 级 · ' + esc(member.major || '') + ' · ' + esc(member.role || '成员') + '</span></div>' +
        '</div>' +
        '<div class="kv"><span>学号</span><b>' + esc(member.sid || '—') + '</b></div>' +
        '<div class="kv"><span>我的帖子</span><b>' + S.userPosts.length + ' 条</b></div>' +
        '<div class="kv"><span>点赞过</span><b>' + S.liked.length + ' 条</b></div>' +
      '</div>' +
      (S.applied && S.applied.length
        ? '<div class="dsec" style="margin-top:4px">已申请的团队</div>' +
          S.applied.map(function (id) {
            var t = TEAMS.filter(function (x) { return x.id === id; })[0];
            if (!t) return '';
            return '<div class="mini" style="margin:0 0 8px" onclick="closeSheet();setTimeout(function(){openTeam(\'' + t.id + '\')},260)">' +
              '<div class="mico" style="background:' + t.cover + '">' + t.emoji + '</div>' +
              '<div class="mt"><b>' + esc(t.name) + '</b><span>' + t.year + ' 届 · ' + esc(t.field) + '</span></div>' +
            '</div>';
          }).join('')
        : '') +
      '<button class="btn" style="width:100%;height:46px;border:0;border-radius:13px;background:#f4f5fa;color:#5b6478;font-family:inherit;font-size:14px;font-weight:600;cursor:pointer" onclick="logout()">退出登录</button>';
    openSheet();
  };

  $('meBtn').onclick = openMe;

  bindSearch('qMem', 'searchMem', 'mem');

  renderFeed();
  renderGallery();
  renderWork();
  renderTalk();
  renderMem();
  renderDoc();

  try {
    if (localStorage.getItem('iea_tip_hist') === '1') {
      var tp = $('histTip');
      if (tp) tp.classList.add('gone');
    }
  } catch (e) {}

  // 支持 #history 这类直达链接
  try {
    var hash = (location.hash || '').replace('#', '');
    if (hash === 'history') go('history');
    else if (hash && ['home','work','talk','people','doc'].indexOf(hash) >= 0) go(hash);
  } catch (e) {}
}

/* ============================================================
   首页动态（内置一份默认值；data.json 存在时会覆盖）
   ============================================================ */
var FEED = [
  { ico: '🏆', title: '《AI 汉方喵粮》获第十五届「挑战杯」全国二等奖，实现该赛事成绩新突破', meta: '2026-11 · 国家级奖项', tab: 'work' },
  { ico: '🥇', title: '省赛 1 金 4 银 7 铜，学院蝉联「优胜杯」', meta: '2026-06 · 省级奖项', tab: 'work' },
  { ico: '🏅', title: '学院获批安徽省省级创新创业学院立项单位（全省 16 所高校之一）', meta: '2022-09 · 学院建设', tab: 'talk' },
  { ico: '📊', title: '近三年学生获国家级、省级奖项 1200 多项', meta: '学院简介 · 数据', tab: 'doc' }
];

function renderFeed() {
  var el = $('feedList');
  if (!el) return;
  if (!FEED.length) {
    el.innerHTML = '<div class="empty" style="padding:28px 0">暂无动态</div>';
    return;
  }
  el.innerHTML = FEED.map(function (f) {
    return '<div class="feed-item" onclick="go(\'' + (f.tab || 'home') + '\')">' +
      '<span class="ico">' + (f.ico || '📌') + '</span>' +
      '<div><b>' + esc(f.title) + '</b><span class="meta">' + esc(f.meta || '') + '</span></div>' +
    '</div>';
  }).join('');
}

/* ============================================================
   外部数据：改 data.json 就能更新内容，不用动 HTML
   ============================================================ */
function applyData(d) {
  if (Array.isArray(d.feed)) FEED = d.feed;
  if (Array.isArray(d.projects)) PROJECTS = d.projects;
  if (Array.isArray(d.posts)) SEED_POSTS = d.posts;
  if (Array.isArray(d.members)) MEMBERS = d.members;
  if (Array.isArray(d.teams)) TEAMS = d.teams;
  if (Array.isArray(d.activities)) ACTIVITIES = d.activities;
  if (Array.isArray(d.docGroups)) DOC_GROUPS = d.docGroups;
  if (Array.isArray(d.cohorts)) COHORTS = d.cohorts;

  renderFeed();
  if (current === 'home') renderGallery();
  if (current === 'work') renderWork();
  if (current === 'talk') renderTalk();
  if (current === 'people') setPeopleMode(peopleMode);
  if (current === 'doc') renderDoc();
}

(function loadRemoteData() {
  if (location.protocol === 'file:') return;
  fetch('data.json', { cache: 'no-store' })
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (d) { if (d) applyData(d); })
    .catch(function () {});
})();

/* ============================================================
   登录闸门（验证码 2606）
   ============================================================ */
var G = { sid: '', member: null };
var gTimer = null;
var DEMO_CODE = '2606';

var KNOWN = {
  '2023010101': { name: '林小满', cohort: '2023', major: '水利水电建筑工程', role: '成员' },
  '2024010157': { name: '苏晴',   cohort: '2024', major: '工程造价',       role: '成员' },
  '2022010233': { name: '陈亦航', cohort: '2022', major: '水利行业创业',   role: '校友' }
};

function gErr(id, text) {
  var el = $(id);
  if (!el) return;
  if (!text) { el.className = 'gate-err'; el.textContent = ''; return; }
  el.className = 'gate-err on';
  el.textContent = text;
}

function hideGate(instant) {
  var g = $('gate');
  if (!g) return;
  if (instant) { g.style.display = 'none'; return; }
  g.classList.add('out');
  setTimeout(function () { g.style.display = 'none'; }, 460);
}

function gNext() {
  var sid = $('gSid').value.trim();
  if (sid.length < 4) return gErr('gErr1', '学号至少 4 位');
  gErr('gErr1', '');
  G.sid = sid;

  var k = KNOWN[sid] || { name: '演示成员', cohort: '—', major: '待完善', role: '成员' };
  G.member = { sid: sid, name: k.name, cohort: k.cohort, major: k.major, role: k.role };

  $('gAv').textContent = k.name.charAt(0);
  $('gWhoName').textContent = k.name;
  $('gWhoMeta').textContent = k.cohort + ' 级 · ' + k.major;

  $('g1').hidden = true;
  $('g2').hidden = false;
  var bars = document.querySelectorAll('.gate-steps i');
  if (bars[0]) bars[0].className = 'done';
  if (bars[1]) bars[1].className = 'on';
  setTimeout(function () { var p = $('gPhone'); if (p) p.focus(); }, 80);
}

function gSend() {
  var phone = $('gPhone').value.trim();
  if (!/^\d{11}$/.test(phone)) return gErr('gErr2', '请输入任意 11 位数字（如 13800138264）');
  gErr('gErr2', '');
  $('gCode').value = DEMO_CODE;
  $('gTip').hidden = false;

  var left = 60;
  var btn = $('gSendBtn');
  btn.disabled = true;
  btn.textContent = left + 's';
  clearInterval(gTimer);
  gTimer = setInterval(function () {
    left -= 1;
    if (left <= 0) {
      clearInterval(gTimer);
      btn.disabled = false;
      btn.textContent = '重新获取';
      return;
    }
    btn.textContent = left + 's';
  }, 1000);
}

function gDone() {
  var phone = $('gPhone').value.trim();
  if (!/^\d{11}$/.test(phone)) return gErr('gErr2', '请输入任意 11 位数字');
  if ($('gCode').value.trim() !== DEMO_CODE) return gErr('gErr2', '验证码不对，演示版请填 ' + DEMO_CODE);

  G.member.phone = phone.slice(0, 3) + '****' + phone.slice(7);
  try { localStorage.setItem('iea_member', JSON.stringify(G.member)); } catch (e) {}
  member = G.member;

  hideGate(false);
  setTimeout(bootApp, 180);
}

/* 启动 —— 开发期跳过登录闸门（要恢复登录，把 SKIP_LOGIN 改成 false） */
var SKIP_LOGIN = true;

if (SKIP_LOGIN || loadJSON('iea_member', null)) {
  hideGate(true);
  bootApp();
} else {
  ['gPhone', 'gCode'].forEach(function (id) {
    var el = $(id);
    if (el) el.addEventListener('input', function (e) {
      e.target.value = e.target.value.replace(/\D/g, '');
    });
  });
  setTimeout(function () { var s = $('gSid'); if (s) s.focus(); }, 220);
}

/* ============================================================
   清理外部注入的浮层
   —— Netlify 未认领的临时站点会在页面里塞「Powered by Netlify」
   角标和「Build your own site」弹窗，会压住底部导航。这里把它们清掉。
   ============================================================ */
(function cleanInjected() {
  var KEEP = { gate: 1, mask: 1, sheet: 1, toast: 1 };
  var SKIP_TAGS = { SCRIPT: 1, STYLE: 1, LINK: 1, META: 1, NOSCRIPT: 1, TEMPLATE: 1 };

  function sweep() {
    var kids = Array.prototype.slice.call(document.body.children);
    for (var i = 0; i < kids.length; i++) {
      var el = kids[i];
      if (SKIP_TAGS[el.tagName]) continue;
      if (el.id && KEEP[el.id]) continue;
      if (el.classList && el.classList.contains('app')) continue;
      if (el.parentNode) el.parentNode.removeChild(el);
    }
  }

  function hook() {
    sweep();
    try {
      new MutationObserver(sweep).observe(document.body, { childList: true });
    } catch (e) {}
    [300, 1200, 3000, 6000].forEach(function (t) { setTimeout(sweep, t); });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', hook);
  } else {
    hook();
  }
})();

/* ============================================================
   成果 · 3D 环形档案（覆盖上面的旧实现）
   ============================================================ */
var ringPos = 0;
var draggingRing = false;
var ringStartX = 0;
var ringStartPos = 0;
var ringMoved = false;
var ringSuppress = false;

function clampNum(v, a, b) { return v < a ? a : (v > b ? b : v); }

function renderWork() {
  renderRing();
  layoutRing();
  applySeason(Math.round(ringPos));
}

function renderRing() {
  var scene = $('ringScene');
  if (!scene) return;
  scene.innerHTML = COHORTS.map(function (c, i) {
    var photo = c.photo && PHOTOS[c.photo] ? PHOTOS[c.photo] : '';
    var stat = (c.stats || []).map(function (s) { return s.v; }).join(' · ');
    return '<div class="ringCard" data-i="' + i + '" onclick="pickSeason(' + i + ')">' +
      '<div class="rcImg" style="' + (photo
        ? 'background-image:url(' + photo + ');'
        : 'background:linear-gradient(135deg,#6366f1,#a855f7);') + '">' +
        '<span class="rcYear">' + c.year + '</span>' +
      '</div>' +
      '<div class="rcBody"><b>' + esc(c.headline) + '</b><span>' + esc(stat) + '</span></div>' +
    '</div>';
  }).join('');
  bindRing();
}

function layoutRing() {
  var scene = $('ringScene');
  if (!scene) return;
  var R = 300;
  var step = 40;
  var kids = scene.children;
  var center = Math.round(ringPos);
  for (var i = 0; i < kids.length; i++) {
    var d = i - ringPos;
    var ad = Math.abs(d);
    var el = kids[i];
    el.style.transform = 'rotateY(' + (-d * step) + 'deg) translateZ(' + R + 'px) scale(' +
      (1 - Math.min(ad * 0.14, 0.5)) + ')';
    el.style.opacity = ad > 2.4 ? 0 : String(Math.max(0.18, 1 - ad * 0.3));
    el.style.zIndex = String(200 - Math.round(ad * 20));
    el.style.pointerEvents = ad > 2.4 ? 'none' : 'auto';
    el.classList.toggle('on', i === center);
  }
}

function pickSeason(i) {
  if (ringSuppress) return;
  ringPos = clampNum(i, 0, COHORTS.length - 1);
  layoutRing();
  applySeason(Math.round(ringPos));
}

function applySeason(i) {
  var c = COHORTS[i];
  if (!c) return;
  histYear = c.year;
  renderHistory();
}

function snapRing() {
  var target = clampNum(Math.round(ringPos), 0, COHORTS.length - 1);
  ringPos = target;
  layoutRing();
  applySeason(target);
}

function bindRing() {
  var wrap = $('ringWrap');
  if (!wrap || wrap.dataset.bound) return;
  wrap.dataset.bound = '1';

  wrap.addEventListener('pointerdown', function (e) {
    draggingRing = true;
    ringMoved = false;
    ringStartX = e.clientX;
    ringStartPos = ringPos;
    wrap.classList.add('dragging');
    try { wrap.setPointerCapture(e.pointerId); } catch (err) {}
  });

  wrap.addEventListener('pointermove', function (e) {
    if (!draggingRing) return;
    var dx = e.clientX - ringStartX;
    if (Math.abs(dx) > 8) ringMoved = true;
    ringPos = clampNum(ringStartPos - dx / 110, 0, COHORTS.length - 1);
    layoutRing();
  });

  function end() {
    if (!draggingRing) return;
    draggingRing = false;
    wrap.classList.remove('dragging');
    if (ringMoved) {
      ringSuppress = true;
      setTimeout(function () { ringSuppress = false; }, 140);
    }
    snapRing();
  }
  wrap.addEventListener('pointerup', end);
  wrap.addEventListener('pointercancel', end);
  wrap.addEventListener('pointerleave', end);
}

/* ============================================================
   3D 环 · 自动旋转 + 无缝循环（覆盖上一版实现）
   ============================================================ */
var ringPos = 0;
var draggingRing = false;
var ringStartX = 0;
var ringStartPos = 0;
var ringMoved = false;
var ringSuppress = false;
var ringCenter = 0;
var ringRaf = null;
var ringLastT = 0;
var ringPauseUntil = 0;
var R_STEP = 40;
var R_RADIUS = 300;

function ringMod(d) {
  var N = COHORTS.length || 1;
  var x = ((d % N) + N) % N;
  if (x > N / 2) x -= N;
  return x;
}

function ringCenterIndex() {
  var N = COHORTS.length || 1;
  return ((Math.round(ringPos) % N) + N) % N;
}

function renderWork() {
  ringCenter = ringCenterIndex();
  renderRing();
  layoutRing();
  applySeason(ringCenter);
  startRingLoop();
}

function layoutRing() {
  var scene = $('ringScene');
  if (!scene) return;
  var kids = scene.children;
  var ci = ringCenterIndex();
  for (var i = 0; i < kids.length; i++) {
    var d = ringMod(i - ringPos);
    var ad = Math.abs(d);
    var el = kids[i];
    el.style.transform = 'rotateY(' + (-d * R_STEP) + 'deg) translateZ(' + R_RADIUS +
      'px) scale(' + (1 - Math.min(ad * 0.14, 0.5)) + ')';
    el.style.opacity = String(Math.max(0.16, 1 - ad * 0.34));
    el.style.zIndex = String(200 - Math.round(ad * 20));
    el.classList.toggle('on', i === ci);
  }
  if (ci !== ringCenter) {
    ringCenter = ci;
    applySeason(ci);
  }
}

function pickSeason(i) {
  if (ringSuppress || draggingRing) return;
  ringPos += ringMod(i - ringPos);
  snapRing();
  ringPause(3200);
}

function applySeason(i) {
  var c = COHORTS[i];
  if (!c) return;
  histYear = c.year;
  renderHistory();
}

function snapRing() {
  var wrap = $('ringWrap');
  ringPos = Math.round(ringPos);
  if (wrap) {
    wrap.classList.add('snapping');
    setTimeout(function () { wrap.classList.remove('snapping'); }, 420);
  }
  layoutRing();
}

function ringPause(ms) { ringPauseUntil = Date.now() + (ms || 2800); }

function startRingLoop() {
  if (ringRaf || !window.requestAnimationFrame) return;
  ringLastT = 0;
  (function step(t) {
    ringRaf = requestAnimationFrame(step);
    if (!ringLastT) { ringLastT = t; return; }
    var dt = Math.min((t - ringLastT) / 1000, 0.05);
    ringLastT = t;
    if (document.hidden || draggingRing) return;
    if (typeof current !== 'undefined' && current !== 'work') return;
    if (Date.now() < ringPauseUntil) return;
    ringPos += 0.17 * dt;      // 约 5.5 秒转一张，慢速不晃眼
    layoutRing();
  })(performance.now());
}

function bindRing() {
  var wrap = $('ringWrap');
  if (!wrap || wrap.dataset.bound) return;
  wrap.dataset.bound = '1';

  wrap.addEventListener('pointerdown', function (e) {
    draggingRing = true;
    ringMoved = false;
    ringStartX = e.clientX;
    ringStartPos = ringPos;
    wrap.classList.remove('snapping');
    wrap.classList.add('dragging');
    try { wrap.setPointerCapture(e.pointerId); } catch (err) {}
  });

  wrap.addEventListener('pointermove', function (e) {
    if (!draggingRing) return;
    var dx = e.clientX - ringStartX;
    if (Math.abs(dx) > 8) ringMoved = true;
    ringPos = ringStartPos - dx / 110;
    layoutRing();
  });

  function end() {
    if (!draggingRing) return;
    draggingRing = false;
    wrap.classList.remove('dragging');
    if (ringMoved) {
      ringSuppress = true;
      setTimeout(function () { ringSuppress = false; }, 160);
      snapRing();
    }
    ringPause(3200);
  }
  wrap.addEventListener('pointerup', end);
  wrap.addEventListener('pointercancel', end);
  wrap.addEventListener('pointerleave', end);
}

/* ============================================================
   视差滚动引擎：不同元素按不同系数随滚动位移
   ============================================================ */
(function parallaxEngine() {
  var pages = $('pages');
  if (!pages) return;

  var els = [];
  var ticking = false;

  function collect() {
    // 条例：视差只作用于「装饰层」，绝不作用于内容块（会遮挡相邻内容）
    els = Array.prototype.slice.call(document.querySelectorAll('[data-par]'));
    for (var i = 0; i < els.length; i++) els[i]._base = null;
  }

  function measure(el) {
    var prev = el.style.translate;
    el.style.translate = '0 0';
    el._base = el.getBoundingClientRect().top + pages.scrollTop;
    el.style.translate = prev;
  }

  function apply() {
    var vh = pages.clientHeight;
    var st = pages.scrollTop;
    for (var i = 0; i < els.length; i++) {
      var el = els[i];
      if (!el.isConnected) continue;
      if (el._base == null) measure(el);
      if (el._base > st + vh + 260 || el._base + el.offsetHeight < st - 260) continue;
      var f = parseFloat(el.getAttribute('data-par')) || 0.06;
      var center = el._base - st + el.offsetHeight / 2;
      var y = -(center - vh / 2) * f;
      el.style.translate = '0 ' + y.toFixed(1) + 'px';
    }
  }

  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () { ticking = false; apply(); });
  }

  pages.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', function () { collect(); apply(); });

  if (window.MutationObserver) {
    new MutationObserver(function () {
      collect();
      requestAnimationFrame(apply);
    }).observe(pages, { childList: true, subtree: true });
  }

  collect();
  apply();
})();

/* ============================================================
   成果 · 3D 书架（每本书 = 一个项目，自动循环滑动）
   ============================================================ */
var shelfS = 0;
var shelfT = 0;
var shelfCopies = 3;
var shelfRaf = null;
var shelfLastT = 0;
var shelfPauseUntil = 0;
var shelfDragging = false;
var shelfDragX = 0;
var shelfDragS = 0;
var shelfMoved = false;
var shelfActive = -1;
var SHELF = { ws: 26, d: 132, bh: 176, gap: 6 };

function smoothstep(x) { return x * x * (3 - 2 * x); }

function shelfB(r) {
  if (r >= 1) return 0.5;
  if (r <= -1) return -0.5;
  return (r + Math.sin(Math.PI * r) / Math.PI) / 2;
}

function shelfMod(x, m) { return ((x % m) + m) % m; }

function renderWork() {
  shelfS = 0;
  shelfT = 0;
  shelfActive = -1;
  renderShelf();
  layoutShelf();
  setTimeout(shelfHealthCheck, 60);
  startShelfLoop();
}

function renderShelf() {
  var stage = $('shelfStage');
  if (!stage) return;
  var out = '';
  for (var c = 0; c < shelfCopies; c++) {
    for (var i = 0; i < PROJECTS.length; i++) {
      var p = PROJECTS[i];
      out += '<div class="book" data-v="' + (c * PROJECTS.length + i) + '" data-i="' + i + '">' +
        '<div class="face sp" style="background:' + p.cover + '"><span>' + esc(p.y) + '</span></div>' +
        '<div class="face cv" style="background:' + p.cover + '">' +
          '<div class="cvt">' + esc(p.t) + '</div>' +
          '<div class="cve">' + p.emoji + '</div>' +
        '</div>' +
      '</div>';
    }
  }
  stage.innerHTML = out;
  bindShelf();
}

function layoutShelf() {
  var stage = $('shelfStage');
  if (!stage) return;
  var N = PROJECTS.length;
  if (!N) return;
  var total = N * shelfCopies;
  var W = $('pages') ? $('pages').clientWidth : 400;
  var step = SHELF.ws + SHELF.gap;
  var extra = SHELF.d - SHELF.ws + 1.6 * SHELF.gap;
  var kids = stage.children;

  for (var k = 0; k < kids.length; k++) {
    var el = kids[k];
    var v = Number(el.getAttribute('data-v'));
    var r = shelfMod(v - shelfS + total * 0.5, total) - total * 0.5;
    var x = r * step + extra * shelfB(r);
    if (Math.abs(x) > W / 2 + SHELF.d * 1.3) { el.style.visibility = 'hidden'; continue; }
    el.style.visibility = 'visible';
    var o = smoothstep(Math.max(0, 1 - Math.abs(r)));
    el.style.transform = 'translate3d(' + x.toFixed(1) + 'px,' + (-o * 0.025 * SHELF.bh).toFixed(1) +
      'px,' + (o * 0.2 * SHELF.bh).toFixed(1) + 'px) rotateZ(' + (-4.5 * o).toFixed(2) +
      'deg) rotateY(' + (-90 * o).toFixed(2) + 'deg)';
    el.style.zIndex = String(Math.round(100 - Math.abs(r) * 4));
  }

  var act = shelfMod(Math.round(shelfS), N);
  if (act !== shelfActive) {
    shelfActive = act;
    renderQuick(PROJECTS[act]);
  }
}

function renderQuick(p) {
  var el = $('projQuick');
  if (!el || !p) return;
  el.innerHTML =
    '<div class="mini" style="margin:0" onclick="openProject(\'' + p.id + '\')">' +
      '<div class="mico" style="background:' + p.cover + '">' + p.emoji + '</div>' +
      '<div class="mt"><b>' + esc(p.t) + '</b>' +
      '<span>' + p.y + ' · ' + esc(p.cat) + ' · ' + esc(p.award) + '</span></div>' +
      '<span style="color:var(--brand);font-size:11px;font-weight:600">看复盘</span>' +
    '</div>';
}

function shelfGo(i) {
  var N = PROJECTS.length;
  var cur = Math.round(shelfT);
  var diff = shelfMod(i - shelfMod(cur, N) + N, N);
  if (diff > N / 2) diff -= N;
  shelfT = cur + diff;
  shelfPause(2800);
}

function shelfPause(ms) { shelfPauseUntil = Date.now() + (ms || 2600); }

function startShelfLoop() {
  if (shelfRaf || !window.requestAnimationFrame) return;
  shelfLastT = 0;
  (function step(t) {
    shelfRaf = requestAnimationFrame(step);
    if (!shelfLastT) { shelfLastT = t; return; }
    var dt = Math.min((t - shelfLastT) / 1000, 0.05);
    shelfLastT = t;
    if (document.hidden) return;
    if (typeof current !== 'undefined' && current !== 'work') return;

    if (!shelfDragging && Date.now() > shelfPauseUntil) shelfT += 0.25 * dt;

    var k = shelfDragging ? 18 : 6.5;
    shelfS += (shelfT - shelfS) * (1 - Math.exp(-k * dt));
    if (Math.abs(shelfT - shelfS) < 0.0006) shelfS = shelfT;

    layoutShelf();
  })(performance.now());
}

function bindShelf() {
  var wrap = $('shelfWrap');
  if (!wrap || wrap.dataset.bound) return;
  wrap.dataset.bound = '1';

  function bookAt(e) {
    var n = e.target;
    while (n && n !== wrap) {
      if (n.classList && n.classList.contains('book')) return n;
      n = n.parentNode;
    }
    return null;
  }

  wrap.addEventListener('pointerdown', function (e) {
    if (!bookAt(e)) return;
    shelfDragging = true;
    shelfMoved = false;
    shelfDragX = e.clientX;
    shelfDragS = shelfT;
    try { wrap.setPointerCapture(e.pointerId); } catch (err) {}
  });

  wrap.addEventListener('pointermove', function (e) {
    if (!shelfDragging) return;
    var dx = e.clientX - shelfDragX;
    if (Math.abs(dx) > 5) shelfMoved = true;
    shelfT = shelfDragS - dx / (SHELF.ws + SHELF.gap);
  });

  wrap.addEventListener('pointerup', function (e) {
    if (!shelfDragging) return;
    shelfDragging = false;
    if (shelfMoved) {
      shelfT = Math.round(shelfT);
      shelfPause(2600);
      return;
    }
    var book = bookAt(e);
    if (!book) return;
    var i = Number(book.getAttribute('data-i'));
    var v = Number(book.getAttribute('data-v'));
    var N = PROJECTS.length;
    var total = N * shelfCopies;
    var r = shelfMod(v - shelfS + total * 0.5, total) - total * 0.5;
    if (Math.abs(r) < 0.5) openProject(PROJECTS[i].id);
    else shelfGo(i);
  });
}

/* ============================================================
   书架渲染（单平面版，覆盖前面的立方体实现）
   ============================================================ */
function renderShelf() {
  var stage = $('shelfStage');
  if (!stage) return;
  var out = '';
  for (var c = 0; c < shelfCopies; c++) {
    for (var i = 0; i < PROJECTS.length; i++) {
      var p = PROJECTS[i];
      out += '<div class="book" data-v="' + (c * PROJECTS.length + i) + '" data-i="' + i + '"' +
        ' style="background:' + p.cover + '">' +
        '<div class="bkSpine">' + esc(p.y) + '</div>' +
        '<div class="bkCover" style="opacity:0"><b>' + esc(p.t) + '</b><em>' + p.emoji + '</em></div>' +
        '<div class="bkShade"></div>' +
      '</div>';
    }
  }
  stage.innerHTML = out;
  bindShelf();
}

function layoutShelf() {
  var stage = $('shelfStage');
  if (!stage) return;
  var N = PROJECTS.length;
  if (!N) return;
  var total = N * shelfCopies;
  var W = $('pages') ? $('pages').clientWidth || 400 : 400;
  var ws = SHELF.ws, d = SHELF.d, gap = SHELF.gap;
  var step = ws + gap;
  var extra = d - ws;
  var kids = stage.children;

  for (var k = 0; k < kids.length; k++) {
    var el = kids[k];
    var v = Number(el.getAttribute('data-v'));
    var r = shelfMod(v - shelfS + total * 0.5, total) - total * 0.5;
    var x = r * step + extra * shelfB(r);
    if (Math.abs(x) > W / 2 + d * 1.4) { el.style.visibility = 'hidden'; continue; }
    el.style.visibility = 'visible';

    var o = smoothstep(Math.max(0, 1 - Math.abs(r)));
    var w = ws + (d - ws) * o;
    el.style.width = w.toFixed(1) + 'px';
    el.style.transform = 'perspective(900px) translate3d(' + (x - w / 2).toFixed(1) + 'px,' +
      (-o * 5).toFixed(1) + 'px,0) rotateY(' + (-r * 5).toFixed(1) + 'deg)';
    el.style.zIndex = String(Math.round(100 - Math.abs(r) * 4));

    var cover = el.children[1];
    var spine = el.children[0];
    var shade = el.children[2];
    if (spine) spine.style.opacity = (1 - o).toFixed(2);
    if (cover) cover.style.opacity = o.toFixed(2);
    if (shade) shade.style.opacity = ((1 - o) * 0.28).toFixed(2);
  }

  var act = shelfMod(Math.round(shelfS), N);
  if (act !== shelfActive) {
    shelfActive = act;
    renderQuick(PROJECTS[act]);
    if (location.search.indexOf('debug') >= 0) {
      var dbg = document.querySelector('.shelfHint');
      if (dbg) dbg.textContent = 'DEBUG · 书=' + PROJECTS.length + ' · s=' + shelfS.toFixed(2) +
        ' · 宽=' + W + ' · 可见=' + visibleCount(stage);
    }
  }
}

function visibleCount(stage) {
  var n = 0;
  for (var i = 0; i < stage.children.length; i++) {
    if (stage.children[i].style.visibility !== 'hidden') n++;
  }
  return n;
}

/* ============================================================
   书架兜底：3D 不生效时退化成普通横滑卡片，保证不空白
   ============================================================ */
function shelfHealthCheck() {
  var stage = $('shelfStage');
  var wrap = $('shelfWrap');
  if (!stage || !wrap) return;
  var kids = stage.children;
  var vis = 0;
  for (var i = 0; i < kids.length; i++) {
    var w = parseFloat(kids[i].style.width || '0');
    if (kids[i].style.visibility !== 'hidden' && w > 0) vis++;
  }
  if (vis >= 3) return;   // 正常，不用兜底

  var out = '';
  for (var j = 0; j < PROJECTS.length; j++) {
    var p = PROJECTS[j];
    out += '<div class="bkFlat" onclick="openProject(\'' + p.id + '\')">' +
      '<div class="bkFlatTop" style="background:' + p.cover + '">' + p.emoji + '</div>' +
      '<b>' + esc(p.t) + '</b><span>' + p.y + ' · ' + esc(p.award) + '</span></div>';
  }
  wrap.innerHTML = '<div class="shelfFlat">' + out + '</div>';
  wrap.style.height = 'auto';
  var hint = document.querySelector('.shelfHint');
  if (hint) hint.textContent = '左右滑动查看全部项目 · 点击查看复盘';
}

/* ============================================================
   成果页：恢复成卡片列表（覆盖书架实现）
   ============================================================ */
/* ============================================================
   成果页：最终版 = 带真实照片的 3D 环（覆盖前面的滚带/书架/列表）
   ============================================================ */
function renderWork() {
  renderRing();
  ringCenter = ringCenterIndex();
  layoutRing();
  applySeason(ringCenter);
  startRingLoop();
}


function renderWorkListUnused() {
  var cats = ['全部', '国创', '挑战杯', '互联网+', '校友创业'];
  $('fWork').innerHTML = cats.map(function (c) {
    return '<button class="f' + (c === workFilter ? ' on' : '') +
      '" onclick="setWorkFilter(\'' + c + '\')">' + c + '</button>';
  }).join('');

  var q = workQuery.trim().toLowerCase();
  var list = PROJECTS.filter(function (p) {
    if (workFilter !== '全部' && p.cat !== workFilter) return false;
    if (!q) return true;
    return (p.t + p.desc + p.tags.join('') + p.cat).toLowerCase().indexOf(q) >= 0;
  });

  $('fWork').innerHTML += '<span class="cnt">共 ' + list.length + ' 个</span>';

  if (!list.length) {
    $('listWork').innerHTML = '<div class="empty">没有匹配的项目<br>试试换个关键词或筛选条件</div>';
    return;
  }

  $('listWork').innerHTML = list.map(function (p) {
    return '' +
    '<div class="proj" onclick="openProject(\'' + p.id + '\')">' +
      '<div class="cover' + (p.photo && PHOTOS[p.photo] ? ' img' : '') + '" style="' +
        (p.photo && PHOTOS[p.photo]
          ? 'background-image:linear-gradient(180deg,rgba(15,23,42,.08),rgba(15,23,42,.60)),url(' + PHOTOS[p.photo] + ');background-size:cover;background-position:center'
          : 'background:' + p.cover) + '">' +
        (p.photo && PHOTOS[p.photo] ? '' : p.emoji) +
        '<span class="award">' + esc(p.award) + '</span>' +
        '<span class="yr">' + p.y + '</span>' +
      '</div>' +
      '<div class="pbody">' +
        '<h3>' + esc(p.t) + '</h3>' +
        '<p class="desc">' + esc(p.desc) + '</p>' +
        '<div class="tags">' + p.tags.map(function (t) { return '<span class="tag">' + esc(t) + '</span>'; }).join('') + '</div>' +
        '<div class="pfoot">' +
          '<div class="team">' +
            p.team.slice(0, 3).map(function (n) {
              return '<span class="avs" style="background:' + avStyle(avatarKey(n)) + '">' + esc(n.charAt(0)) + '</span>';
            }).join('') +
            '<span style="margin-left:7px">' + p.team.length + ' 人 · ' + esc(p.status) + '</span>' +
          '</div>' +
          '<span style="color:var(--brand);font-weight:600">看复盘 →</span>' +
        '</div>' +
      '</div>' +
    '</div>';
  }).join('');
}

/* ============================================================
   首页循环视频：加载成功就播放，失败则显示可点击的兜底块
   ============================================================ */
(function heroVideo() {
  var v = $('heroVid');
  var fb = $('heroVidFallback');
  if (!v || !fb) return;

  function fail() { fb.classList.add('on'); }

  v.addEventListener('playing', function () {
    v.classList.add('on');
    fb.classList.remove('on');
  });
  v.addEventListener('error', fail);
  var src = v.querySelector('source');
  if (src) src.addEventListener('error', fail);

  setTimeout(function () { if (!v.classList.contains('on')) fail(); }, 1600);

  if (v.play) { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
})();

/* ============================================================
   成果页：最终版 = 3D 环绕（卡片自动旋转 + 下方详情自动展开）
   ============================================================ */
function renderWork() {
  renderRing();
  ringCenter = ringCenterIndex();
  layoutRing();
  applySeason(ringCenter);
  startRingLoop();
}


function renderCase() {
  var p = PROJECTS[caseIdx];
  if (!p) return;

  var item = $('caseItem');
  if (item) {
    var photo = p.photo && PHOTOS[p.photo] ? PHOTOS[p.photo] : '';
    item.innerHTML = (photo
        ? '<div class="ciBg" style="background-image:url(' + photo + ')"></div>'
        : '<div class="ciBg" style="background:' + p.cover + '"></div>' +
          '<div class="ciArt">' + p.emoji + '</div>')
      + '<div class="ciShade"></div>';
    item.style.opacity = '0';
    item.style.transform = 'translateY(7px) scale(.975)';
    requestAnimationFrame(function () {
      item.style.opacity = '1';
      item.style.transform = 'none';
    });
  }

  var t = $('caseTitle');
  if (t) t.textContent = p.t;
  var s = $('caseSub');
  if (s) s.textContent = p.y + ' · ' + p.cat + ' · ' + p.award;

  var dots = $('caseDots');
  if (dots) {
    dots.innerHTML = PROJECTS.map(function (x, i) {
      return '<i class="cd' + (i === caseIdx ? ' on' : '') + '" onclick="setCase(' + i + ')"></i>';
    }).join('');
  }

  var info = $('caseInfo');
  if (info) {
    info.innerHTML = '<div class="mini" style="margin:0" onclick="openProject(\'' + p.id + '\')">' +
      '<div class="mico" style="background:' + p.cover + '">' + p.emoji + '</div>' +
      '<div class="mt"><b>' + esc(p.award) + '</b><span>' +
        esc((p.team || []).length + ' 人团队 · ' + (p.status || '')) + '</span></div>' +
      '<span style="color:var(--brand);font-size:11px;font-weight:600">看复盘</span>' +
    '</div>';
  }
}

function flashCase() {
  var f = $('caseFlash');
  if (!f) return;
  f.classList.remove('on');
  void f.offsetWidth;
  f.classList.add('on');
}

function setCase(i) {
  var n = PROJECTS.length;
  if (!n) return;
  caseIdx = ((i % n) + n) % n;
  flashCase();
  setTimeout(renderCase, 90);
  restartCaseTimer();
}

function nextCase() {
  var n = PROJECTS.length;
  if (!n) return;
  caseIdx = (caseIdx + 1) % n;
  flashCase();
  setTimeout(renderCase, 90);
}

function restartCaseTimer() {
  if (caseTimer) clearInterval(caseTimer);
  caseTimer = setInterval(function () {
    if (document.hidden) return;
    if (typeof current !== 'undefined' && current !== 'work') return;
    nextCase();
  }, 3000);
}

/* ============================================================
   首页主视觉：生成上浮光点
   ============================================================ */
(function heroDots() {
  var el = $('heroDots');
  if (!el) return;
  var h = '';
  for (var i = 0; i < 12; i++) {
    var left = (i * 8.3 + 3.2).toFixed(1);
    var dur = (5.5 + (i % 5) * 1.4).toFixed(1);
    var delay = (i * 0.65).toFixed(1);
    var size = (i % 3 === 0) ? 3 : 2;
    h += '<i style="left:' + left + '%;width:' + size + 'px;height:' + size + 'px;' +
      'animation-duration:' + dur + 's;animation-delay:' + delay + 's"></i>';
  }
  el.innerHTML = h;
})();

/* ============================================================
   首页视频：点一下兜底播放（自动播放被拦时用户可手动触发）
   ============================================================ */
function playHero() {
  var v = $('heroVid');
  if (v && v.paused) {
    var p = v.play();
    if (p && p.catch) p.catch(function () {});
  }
}

/* ============================================================
   首页视频：播放成功才淡入，失败自动回退到水波动画
   ============================================================ */
(function heroVideo() {
  var v = $('heroVid');
  var box = $('heroBox');
  if (!v || !box) return;

  v.addEventListener('playing', function () {
    v.classList.add('on');
    box.classList.add('video-on');
  });

  if (v.play) {
    var p = v.play();
    if (p && p.catch) p.catch(function () { /* 自动播放被拒，保持水波 */ });
  }
})();

/* ============================================================
   首页三棱镜：自动循环折射，依次照亮三组数据
   ============================================================ */
(function prismHeroOld() {
  if (1) return;   // 旧版假折射已停用
  var el = $('prismHero');
  var cv = $('prismCv');
  if (!el || !cv) return;
  var ctx = cv.getContext('2d');
  if (!ctx) return;

  var W = 0, H = 0, dpr = 1;
  var cur = 0, target = 0;
  var stats = document.querySelectorAll('.pstat');
  var statPts = [];
  var reduce = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

  function measureStats() {
    statPts = [];
    var hr = el.getBoundingClientRect();
    for (var i = 0; i < stats.length; i++) {
      var r = stats[i].getBoundingClientRect();
      statPts.push({
        x: r.left - hr.left + r.width * 0.55,
        y: r.top - hr.top + r.height / 2
      });
    }
  }

  function resize() {
    W = el.clientWidth || 400;
    H = el.clientHeight || 400;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = Math.round(W * dpr);
    cv.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    measureStats();
  }

  function draw(now) {
    if (!W) return;
    // 全部用连续的 cur，不再用四舍五入的整数 —— 这是之前“瞬移”的原因
    var f = ((cur % 3) + 3) % 3;
    var i0 = Math.floor(f) % 3;
    var i1 = (i0 + 1) % 3;
    var k = f - Math.floor(f);

    var cx = W * 0.76, cy = H * 0.55;
    var S = Math.min(W * 0.34, H * 0.58, 128);
    var hh = S * 0.866;
    var top = { x: cx, y: cy - hh * 2 / 3 };
    var br = { x: cx + S / 2, y: cy + hh / 3 };
    var bl = { x: cx - S / 2, y: cy + hh / 3 };

    var t = 0.18 + 0.30 * f + 0.04 * Math.sin(f * Math.PI);
    t = Math.max(0.10, Math.min(0.92, t));
    var entry = { x: br.x + (top.x - br.x) * t, y: br.y + (top.y - br.y) * t };

    var src = { x: W + 60, y: entry.y - 18 };

    var et = 0.70 - 0.22 * f;
    et = Math.max(0.1, Math.min(0.92, et));
    var exit = { x: bl.x + (top.x - bl.x) * et, y: bl.y + (top.y - bl.y) * et };

    // 光扇中心角：直接指向当前（插值后的）那一行文字
    var baseAng = Math.PI;
    if (statPts[i0] && statPts[i1]) {
      var tx = statPts[i0].x + (statPts[i1].x - statPts[i0].x) * k;
      var ty = statPts[i0].y + (statPts[i1].y - statPts[i0].y) * k;
      baseAng = Math.atan2(ty - exit.y, tx - exit.x);
    }
    var spread = 0.34;

    ctx.clearRect(0, 0, W, H);
    ctx.globalCompositeOperation = 'lighter';

    var N = 34;
    function fan(alpha, width, blur) {
      ctx.filter = blur ? 'blur(' + blur + 'px)' : 'none';
      for (var i = 0; i < N; i++) {
        var q = i / (N - 1);
        var ang = baseAng + (q - 0.5) * spread;
        var hue = 12 + q * 280;
        ctx.strokeStyle = 'hsla(' + hue + ',100%,62%,' + alpha + ')';
        ctx.lineWidth = width;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(exit.x, exit.y);
        ctx.lineTo(exit.x + Math.cos(ang) * 900, exit.y + Math.sin(ang) * 900);
        ctx.stroke();
      }
      ctx.filter = 'none';
    }

    fan(0.055, 7, 16);
    fan(0.05, 3.5, 6);
    fan(0.09, 1.6, 0);

    ctx.filter = 'blur(6px)';
    ctx.strokeStyle = 'rgba(255,255,255,.35)';
    ctx.lineWidth = 9;
    ctx.beginPath(); ctx.moveTo(src.x, src.y); ctx.lineTo(entry.x, entry.y); ctx.stroke();
    ctx.filter = 'none';
    ctx.strokeStyle = 'rgba(255,255,255,.9)';
    ctx.lineWidth = 2.2;
    ctx.beginPath(); ctx.moveTo(src.x, src.y); ctx.lineTo(entry.x, entry.y); ctx.stroke();

    ctx.strokeStyle = 'rgba(220,235,255,.75)';
    ctx.lineWidth = 1.6;
    ctx.beginPath(); ctx.moveTo(entry.x, entry.y); ctx.lineTo(exit.x, exit.y); ctx.stroke();

    var g = ctx.createRadialGradient(exit.x, exit.y, 0, exit.x, exit.y, S * 0.45);
    g.addColorStop(0, 'rgba(255,255,255,.9)');
    g.addColorStop(0.4, 'rgba(190,220,255,.25)');
    g.addColorStop(1, 'rgba(190,220,255,0)');
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(exit.x, exit.y, S * 0.45, 0, 6.2832); ctx.fill();

    for (var d = 0; d < 14; d++) {
      var p = ((now / 2600) + d / 14) % 1;
      var dx = src.x + (entry.x - src.x) * p;
      var dy = src.y + (entry.y - src.y) * p + Math.sin(p * 6 + d) * 8 * (1 - p);
      var a = 0.25 + 0.5 * Math.abs(Math.sin(p * 9 + d));
      ctx.fillStyle = 'rgba(255,255,255,' + a.toFixed(2) + ')';
      ctx.beginPath(); ctx.arc(dx, dy, 0.6 + (d % 3) * 0.4, 0, 6.2832); ctx.fill();
    }

    ctx.globalCompositeOperation = 'source-over';
    ctx.beginPath();
    ctx.moveTo(top.x, top.y); ctx.lineTo(br.x, br.y); ctx.lineTo(bl.x, bl.y); ctx.closePath();
    var pg = ctx.createLinearGradient(bl.x, top.y, br.x, br.y);
    pg.addColorStop(0, 'rgba(120,150,200,.16)');
    pg.addColorStop(0.5, 'rgba(30,36,52,.55)');
    pg.addColorStop(1, 'rgba(150,180,230,.20)');
    ctx.fillStyle = pg; ctx.fill();
    ctx.strokeStyle = 'rgba(200,220,255,.55)';
    ctx.lineWidth = 1.2; ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(top.x, top.y); ctx.lineTo(br.x, br.y);
    ctx.strokeStyle = 'rgba(255,255,255,.75)';
    ctx.lineWidth = 2; ctx.stroke();
  }

  function tick(now) {
    cur += (target - cur) * 0.10;
    if (Math.abs(target - cur) < 0.001) cur = target;
    draw(now);
    requestAnimationFrame(tick);
  }

  function setActive(i) {
    target = i;
    var on = ((i % 3) + 3) % 3;
    for (var k = 0; k < stats.length; k++) {
      stats[k].classList.toggle('on', k === on);
    }
  }

  resize();
  setActive(0);

  if (reduce) {
    draw(performance.now());
    return;
  }

  requestAnimationFrame(tick);
  draw(performance.now());

  var step = 0;
  setInterval(function () {
    if (document.hidden) return;
    step++;
    setActive(step);
  }, 3600);

  var rt = null;
  window.addEventListener('resize', function () {
    clearTimeout(rt);
    rt = setTimeout(function () { resize(); draw(performance.now()); }, 120);
  });
})();

/* ============================================================
   首页三棱镜 v2：真实 2D 光追
   —— 柯西色散 n(λ) · 向量斯涅尔折射 · 非偏振菲涅尔 · 全反射
   ============================================================ */
(function prismTrace() {
  if (1) return;   // v2 已停用（细线光谱 → 改为 v3 连续色带）
  var el = $('prismHero');
  var cv = $('prismCv');
  if (!el || !cv) return;
  var ctx = cv.getContext('2d');
  if (!ctx) return;

  var W = 0, H = 0, dpr = 1;
  var stats = document.querySelectorAll('.pstat');
  var rows = [];
  var angles = [0, 0, 0];
  var cur = 0, target = 0;
  var reduce = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

  var lightCv = document.createElement('canvas');
  var lctx = lightCv.getContext('2d');

  /* ---------- 向量 ---------- */
  function sub(a, b) { return { x: a.x - b.x, y: a.y - b.y }; }
  function add(a, b) { return { x: a.x + b.x, y: a.y + b.y }; }
  function mul(a, k) { return { x: a.x * k, y: a.y * k }; }
  function len(a) { return Math.hypot(a.x, a.y); }
  function norm(a) { var l = len(a) || 1; return { x: a.x / l, y: a.y / l }; }
  function dot(a, b) { return a.x * b.x + a.y * b.y; }
  function rot(v, a) {
    var c = Math.cos(a), s = Math.sin(a);
    return { x: v.x * c - v.y * s, y: v.x * s + v.y * c };
  }
  function lerp(a, b, t) { return { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t }; }

  /* ---------- 几何 ---------- */
  function geom() {
    var cx = W * 0.77, cy = H * 0.56;
    var S = Math.min(W * 0.34, H * 0.62, 130);
    var h = S * Math.sqrt(3) / 2;
    var T = { x: cx, y: cy - h * 2 / 3 };
    var BR = { x: cx + S / 2, y: cy + h / 3 };
    var BL = { x: cx - S / 2, y: cy + h / 3 };
    var C = { x: cx, y: cy };
    return {
      T: T, BR: BR, BL: BL, C: C, cx: cx, cy: cy, S: S,
      faces: [[T, BR], [BR, BL], [BL, T]]
    };
  }

  function hitSeg(o, d, A, B) {
    var e = sub(B, A);
    var den = d.x * e.y - d.y * e.x;
    if (Math.abs(den) < 1e-9) return null;
    var oa = sub(A, o);
    var t = (oa.x * e.y - oa.y * e.x) / den;
    var u = (oa.x * d.y - oa.y * d.x) / den;
    if (t <= 1e-6 || u < -1e-6 || u > 1 + 1e-6) return null;
    return { t: t, p: add(o, mul(d, t)) };
  }

  function normalOf(A, B, C) {
    var e = sub(B, A);
    var n = norm({ x: -e.y, y: e.x });
    var mid = mul(add(A, B), 0.5);
    if (dot(n, sub(mid, C)) < 0) n = mul(n, -1);
    return n;
  }

  /* ---------- 色散：柯西公式 ---------- */
  function ior(lam) {                 // λ (nm)
    var um = lam / 1000;
    return 1.2 + 0.1 / (um * um);
  }

  function hueOf(lam) {               // 400nm 紫 → 700nm 红
    var t = (lam - 400) / 300;
    return 290 * Math.pow(1 - Math.min(1, Math.max(0, t)), 1.12);
  }

  var LAMS = [];
  for (var li = 0; li < 44; li++) LAMS.push(400 + li * (300 / 43));

  /* ---------- 折射 / 菲涅尔 ---------- */
  function refractDir(d, nIn, eta) {
    var n = nIn;
    var cosi = -dot(n, d);
    if (cosi < 0) { n = mul(n, -1); cosi = -cosi; }
    var k = 1 - eta * eta * (1 - cosi * cosi);
    if (k < 0) return null;
    var cost = Math.sqrt(k);
    return norm(add(mul(d, eta), mul(n, eta * cosi - cost)));
  }

  function fresnelR(d, n, n1, n2) {
    var cosi = Math.abs(dot(n, d));
    var eta = n1 / n2;
    var sint = eta * Math.sqrt(Math.max(0, 1 - cosi * cosi));
    if (sint >= 1) return 1;
    var cost = Math.sqrt(1 - sint * sint);
    var rs = (n1 * cosi - n2 * cost) / (n1 * cosi + n2 * cost);
    var rp = (n1 * cost - n2 * cosi) / (n1 * cost + n2 * cosi);
    return Math.min(1, (rs * rs + rp * rp) / 2);
  }

  /* ---------- 追迹一条波长 ---------- */
  function trace(G, start, dir, nGlass) {
    var segs = [];
    var o = start, d = dir, energy = 1, lastFace = -1;

    for (var bounce = 0; bounce < 6; bounce++) {
      var best = null, bi = -1;
      for (var f = 0; f < 3; f++) {
        if (f === lastFace) continue;
        var h = hitSeg(o, d, G.faces[f][0], G.faces[f][1]);
        if (h && (!best || h.t < best.t)) { best = h; bi = f; }
      }
      if (!best) break;

      var A = G.faces[bi][0], B = G.faces[bi][1];
      var nrm = normalOf(A, B, G.C);
      var inside = bounce > 0;
      var n1 = inside ? nGlass : 1;
      var n2 = inside ? 1 : nGlass;

      segs.push({ a: o, b: best.p, inside: inside, energy: energy });

      var R = fresnelR(d, nrm, n1, n2);
      var nd = refractDir(d, nrm, n1 / n2);

      if (nd && R < 0.9995) {
        energy *= (1 - R);
        segs.push({
          a: best.p, b: add(best.p, mul(nd, 1500)),
          inside: false, energy: energy, exit: true, dir: nd
        });
        return segs;
      }

      // 全反射
      d = norm(sub(d, mul(nrm, 2 * dot(d, nrm))));
      o = best.p;
      lastFace = bi;
      energy *= 0.94;
      if (energy < 0.02) return segs;
    }
    return segs;
  }

  function exitRay(G, theta, lam) {
    var E = lerp(G.T, G.BR, 0.44);
    var nIn = norm(sub(G.C, E));
    var d = rot(nIn, theta);
    var segs = trace(G, E, d, ior(lam));
    for (var i = segs.length - 1; i >= 0; i--) {
      if (segs[i].exit) return { p: segs[i].a, d: segs[i].dir };
    }
    return null;
  }

  /* ---------- 求解：让出射光正对每一行文字 ---------- */
  function solveAngles() {
    var G = geom();
    angles = [0, 0, 0];
    for (var r = 0; r < 3; r++) {
      var P = rows[r];
      if (!P) continue;
      var bestT = null, bestV = 1e9;
      for (var deg = -40; deg <= 80; deg += 0.5) {
        var th = deg * Math.PI / 180;
        var ray = exitRay(G, th, 550);
        if (!ray) continue;
        var v = sub(P, ray.p);
        if (dot(v, ray.d) <= 0) continue;
        var perp = Math.abs(v.x * ray.d.y - v.y * ray.d.x);
        if (perp < bestV) { bestV = perp; bestT = th; }
      }
      angles[r] = bestT === null ? 0 : bestT;
    }
  }

  /* ---------- 尺寸 / 行位置 ---------- */
  function measure() {
    var hr = el.getBoundingClientRect();
    rows = [];
    for (var i = 0; i < stats.length; i++) {
      var r = stats[i].getBoundingClientRect();
      rows.push({ x: r.left - hr.left + r.width * 0.5, y: r.top - hr.top + r.height / 2 });
    }
    solveAngles();
  }

  function resize() {
    W = el.clientWidth || 400;
    H = el.clientHeight || 200;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = Math.round(W * dpr);
    cv.height = Math.round(H * dpr);
    lightCv.width = cv.width;
    lightCv.height = cv.height;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    lctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    measure();
  }

  /* ---------- 绘制 ---------- */
  function draw(now) {
    if (!W) return;
    var G = geom();

    var f = ((cur % 3) + 3) % 3;
    var i0 = Math.floor(f) % 3, i1 = (i0 + 1) % 3, k = f - Math.floor(f);
    var theta = angles[i0] + (angles[i1] - angles[i0]) * k;

    var E = lerp(G.T, G.BR, 0.44);
    var nIn = norm(sub(G.C, E));
    var d = rot(nIn, theta);
    var start = sub(E, mul(d, 950));

    var goal = lerp(rows[i0] || { x: 40, y: H * 0.5 }, rows[i1] || { x: 40, y: H * 0.5 }, k);

    /* --- 光层（离屏） --- */
    lctx.setTransform(1, 0, 0, 1, 0, 0);
    lctx.clearRect(0, 0, lightCv.width, lightCv.height);
    lctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    lctx.globalCompositeOperation = 'lighter';

    // 入射白光
    lctx.strokeStyle = 'rgba(255,255,255,.30)';
    lctx.lineWidth = 8;
    lctx.lineCap = 'round';
    lctx.beginPath(); lctx.moveTo(start.x, start.y); lctx.lineTo(E.x, E.y); lctx.stroke();
    lctx.strokeStyle = 'rgba(255,255,255,.92)';
    lctx.lineWidth = 2.1;
    lctx.beginPath(); lctx.moveTo(start.x, start.y); lctx.lineTo(E.x, E.y); lctx.stroke();

    // 逐波长追迹
    var midExit = null;
    for (var i = 0; i < LAMS.length; i++) {
      var lam = LAMS[i];
      var segs = trace(G, E, d, ior(lam));
      var hue = hueOf(lam);
      for (var s = 0; s < segs.length; s++) {
        var sg = segs[s];
        if (sg.exit) { if (!midExit && lam > 540 && lam < 560) midExit = sg; }
        var a = Math.max(0, Math.min(1, sg.energy));
        var alpha = sg.exit ? 0.15 * a : 0.19 * a;
        if (alpha < 0.004) continue;
        lctx.strokeStyle = 'hsla(' + hue + ',95%,64%,' + alpha.toFixed(3) + ')';
        lctx.lineWidth = sg.exit ? 2.3 : 1.5;
        lctx.beginPath(); lctx.moveTo(sg.a.x, sg.a.y); lctx.lineTo(sg.b.x, sg.b.y); lctx.stroke();
      }
    }

    // 若真实出射方向偏离目标太多，补一层指向目标的柔光扇（保证构图）
    var aimOK = false;
    if (midExit && midExit.dir) {
      var want = norm(sub(goal, E));
      aimOK = dot(midExit.dir, want) > 0.86;
    }
    if (!aimOK) {
      var gd = norm(sub(goal, E));
      for (var j = 0; j < 36; j++) {
        var q = j / 35;
        var ang = Math.atan2(gd.y, gd.x) + (q - 0.5) * 0.42;
        var hue2 = hueOf(400 + q * 300);
        lctx.strokeStyle = 'hsla(' + hue2 + ',95%,64%,0.085)';
        lctx.lineWidth = 2.2;
        lctx.beginPath();
        lctx.moveTo(E.x, E.y);
        lctx.lineTo(E.x + Math.cos(ang) * 900, E.y + Math.sin(ang) * 900);
        lctx.stroke();
      }
    }

    // 出射点光晕
    var gr = lctx.createRadialGradient(E.x, E.y, 0, E.x, E.y, G.S * 0.5);
    gr.addColorStop(0, 'rgba(255,255,255,.55)');
    gr.addColorStop(0.35, 'rgba(190,220,255,.16)');
    gr.addColorStop(1, 'rgba(190,220,255,0)');
    lctx.fillStyle = gr;
    lctx.beginPath(); lctx.arc(E.x, E.y, G.S * 0.5, 0, 6.2832); lctx.fill();

    /* --- 合成到主画布 --- */
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, cv.width, cv.height);
    ctx.globalCompositeOperation = 'lighter';
    ctx.filter = 'blur(12px)';
    ctx.globalAlpha = 0.8;
    ctx.drawImage(lightCv, 0, 0);
    ctx.filter = 'none';
    ctx.globalAlpha = 1;
    ctx.drawImage(lightCv, 0, 0);

    /* --- 玻璃本体 --- */
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.globalCompositeOperation = 'source-over';

    ctx.beginPath();
    ctx.moveTo(G.T.x, G.T.y);
    ctx.lineTo(G.BR.x, G.BR.y);
    ctx.lineTo(G.BL.x, G.BL.y);
    ctx.closePath();

    var pg = ctx.createLinearGradient(G.BL.x, G.T.y, G.BR.x, G.BR.y);
    pg.addColorStop(0, 'rgba(160,195,240,.20)');
    pg.addColorStop(0.42, 'rgba(24,30,46,.62)');
    pg.addColorStop(0.72, 'rgba(40,52,78,.55)');
    pg.addColorStop(1, 'rgba(130,165,220,.24)');
    ctx.fillStyle = pg;
    ctx.fill();

    ctx.strokeStyle = 'rgba(200,222,255,.42)';
    ctx.lineWidth = 1;
    ctx.stroke();

    // 受光边（右面）最亮
    ctx.beginPath();
    ctx.moveTo(G.T.x, G.T.y);
    ctx.lineTo(G.BR.x, G.BR.y);
    ctx.strokeStyle = 'rgba(255,255,255,.85)';
    ctx.lineWidth = 1.9;
    ctx.stroke();

    // 左面内壁反光
    ctx.beginPath();
    ctx.moveTo(G.BL.x, G.BL.y);
    ctx.lineTo(G.T.x, G.T.y);
    ctx.strokeStyle = 'rgba(190,215,255,.30)';
    ctx.lineWidth = 1.1;
    ctx.stroke();

    ctx.globalCompositeOperation = 'source-over';
  }

  /* ---------- 循环 ---------- */
  var lastDraw = 0;
  function tick(now) {
    requestAnimationFrame(tick);
    if (now - lastDraw < 33) return;      // ~30fps
    lastDraw = now;
    cur += (target - cur) * 0.09;
    if (Math.abs(target - cur) < 0.0015) cur = target;
    draw(now);
  }

  function setActive(i) {
    target = i;
    var on = ((i % 3) + 3) % 3;
    for (var k = 0; k < stats.length; k++) stats[k].classList.toggle('on', k === on);
  }

  resize();
  setActive(0);

  if (reduce) { draw(performance.now()); return; }

  requestAnimationFrame(tick);
  draw(performance.now());

  var step = 0;
  setInterval(function () {
    if (document.hidden) return;
    step++;
    setActive(step);
  }, 3600);

  var rt = null;
  window.addEventListener('resize', function () {
    clearTimeout(rt);
    rt = setTimeout(function () { resize(); draw(performance.now()); }, 140);
  });
})();

/* ============================================================
   首页三棱镜 v3：真实光追 + 连续光谱带（锥形渐变填充）
   ============================================================ */
(function prismBand() {
  var el = $('prismHero');
  var cv = $('prismCv');
  if (!el || !cv) return;
  var ctx = cv.getContext('2d');
  if (!ctx) return;

  var W = 0, H = 0, dpr = 1;
  var stats = document.querySelectorAll('.pstat');
  var rows = [], angles = [0, 0, 0];
  var cur = 0, target = 0;
  var reduce = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

  /* ---------- 向量 ---------- */
  function sub(a, b) { return { x: a.x - b.x, y: a.y - b.y }; }
  function add(a, b) { return { x: a.x + b.x, y: a.y + b.y }; }
  function mul(a, k) { return { x: a.x * k, y: a.y * k }; }
  function len(a) { return Math.hypot(a.x, a.y); }
  function norm(a) { var l = len(a) || 1; return { x: a.x / l, y: a.y / l }; }
  function dot(a, b) { return a.x * b.x + a.y * b.y; }
  function rot(v, a) { var c = Math.cos(a), s = Math.sin(a); return { x: v.x * c - v.y * s, y: v.x * s + v.y * c }; }
  function lerp(a, b, t) { return { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t }; }

  /* ---------- 几何（放大版） ---------- */
  function geom() {
    var cx = W * 0.74, cy = H * 0.55;
    var S = Math.min(W * 0.46, H * 0.74, 195);
    var h = S * Math.sqrt(3) / 2;
    var T = { x: cx, y: cy - h * 2 / 3 };
    var BR = { x: cx + S / 2, y: cy + h / 3 };
    var BL = { x: cx - S / 2, y: cy + h / 3 };
    return { T: T, BR: BR, BL: BL, C: { x: cx, y: cy }, S: S, faces: [[T, BR], [BR, BL], [BL, T]] };
  }

  function hitSeg(o, d, A, B) {
    var e = sub(B, A), den = d.x * e.y - d.y * e.x;
    if (Math.abs(den) < 1e-9) return null;
    var oa = sub(A, o);
    var t = (oa.x * e.y - oa.y * e.x) / den;
    var u = (oa.x * d.y - oa.y * d.x) / den;
    if (t <= 1e-6 || u < -1e-6 || u > 1 + 1e-6) return null;
    return { t: t, p: add(o, mul(d, t)) };
  }

  function normalOf(A, B, C) {
    var e = sub(B, A), n = norm({ x: -e.y, y: e.x });
    var mid = mul(add(A, B), 0.5);
    if (dot(n, sub(mid, C)) < 0) n = mul(n, -1);
    return n;
  }

  function ior(lam) { var um = lam / 1000; return 1.2 + 0.1 / (um * um); }

  function refractDir(d, nIn, eta) {
    var n = nIn, cosi = -dot(n, d);
    if (cosi < 0) { n = mul(n, -1); cosi = -cosi; }
    var k = 1 - eta * eta * (1 - cosi * cosi);
    if (k < 0) return null;
    var cost = Math.sqrt(k);
    return norm(add(mul(d, eta), mul(n, eta * cosi - cost)));
  }

  function fresnelR(d, n, n1, n2) {
    var cosi = Math.abs(dot(n, d)), eta = n1 / n2;
    var sint = eta * Math.sqrt(Math.max(0, 1 - cosi * cosi));
    if (sint >= 1) return 1;
    var cost = Math.sqrt(1 - sint * sint);
    var rs = (n1 * cosi - n2 * cost) / (n1 * cosi + n2 * cost);
    var rp = (n1 * cost - n2 * cosi) / (n1 * cost + n2 * cosi);
    return Math.min(1, (rs * rs + rp * rp) / 2);
  }

  function trace(G, start, dir, nGlass) {
    var o = start, d = dir, energy = 1, lastFace = -1, inner = [];
    for (var b = 0; b < 6; b++) {
      var best = null, bi = -1;
      for (var f = 0; f < 3; f++) {
        if (f === lastFace) continue;
        var h = hitSeg(o, d, G.faces[f][0], G.faces[f][1]);
        if (h && (!best || h.t < best.t)) { best = h; bi = f; }
      }
      if (!best) return null;
      var nrm = normalOf(G.faces[bi][0], G.faces[bi][1], G.C);
      var inside = b > 0;
      var R = fresnelR(d, nrm, inside ? nGlass : 1, inside ? 1 : nGlass);
      var nd = refractDir(d, nrm, (inside ? nGlass : 1) / (inside ? 1 : nGlass));
      if (inside) inner.push({ a: o, b: best.p });
      if (nd && R < 0.9995) {
        energy *= (1 - R);
        return { exit: { p: best.p, d: nd, energy: energy }, inner: inner };
      }
      d = norm(sub(d, mul(nrm, 2 * dot(d, nrm))));
      o = best.p; lastFace = bi; energy *= 0.94;
      if (energy < 0.02) return null;
    }
    return null;
  }

  function exitInfo(G, E, d, lam) { return trace(G, E, d, ior(lam)); }

  function solveAngles() {
    var G = geom();
    angles = [0, 0, 0];
    for (var r = 0; r < 3; r++) {
      var P = rows[r];
      if (!P) continue;
      var bestT = null, bestV = 1e9;
      for (var deg = -40; deg <= 80; deg += 0.5) {
        var th = deg * Math.PI / 180;
        var E = lerp(G.T, G.BR, 0.5);
        var nIn = norm(sub(G.C, E));
        var d = rot(nIn, th);
        var ex = exitInfo(G, E, d, 550);
        if (!ex) continue;
        var v = sub(P, ex.exit.p);
        if (dot(v, ex.exit.d) <= 0) continue;
        var perp = Math.abs(v.x * ex.exit.d.y - v.y * ex.exit.d.x);
        if (perp < bestV) { bestV = perp; bestT = th; }
      }
      angles[r] = bestT === null ? 0 : bestT;
    }
  }

  function measure() {
    var hr = el.getBoundingClientRect();
    rows = [];
    for (var i = 0; i < stats.length; i++) {
      var r = stats[i].getBoundingClientRect();
      rows.push({ x: r.left - hr.left + r.width * 0.5, y: r.top - hr.top + r.height / 2 });
    }
    solveAngles();
  }

  function resize() {
    W = el.clientWidth || 400;
    H = el.clientHeight || 240;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = Math.round(W * dpr);
    cv.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    measure();
  }

  /* ---------- 绘制 ---------- */
  function seg(a, b) {
    ctx.beginPath();
    ctx.moveTo(a.x, a.y);
    ctx.lineTo(b.x, b.y);
    ctx.stroke();
  }

  function drawFan(o, lo, span, redAtLo) {
    var TAU = Math.PI * 2;
    if (!ctx.createConicGradient) {
      // 兼容兜底：画 60 条粗线
      for (var i = 0; i < 60; i++) {
        var k = i / 59;
        var ang = lo + k * span;
        var hue = redAtLo ? k * 292 : (1 - k) * 292;
        ctx.strokeStyle = 'hsla(' + hue + ',100%,60%,0.10)';
        ctx.lineWidth = 5;
        ctx.beginPath();
        ctx.moveTo(o.x, o.y);
        ctx.lineTo(o.x + Math.cos(ang) * 1200, o.y + Math.sin(ang) * 1200);
        ctx.stroke();
      }
      return;
    }
    var g = ctx.createConicGradient(lo, o.x, o.y);
    var N = 30;
    for (var j = 0; j <= N; j++) {
      var u = j / N;
      var hue = redAtLo ? u * 292 : (1 - u) * 292;
      g.addColorStop(Math.min(0.999, u * span / TAU), 'hsla(' + hue.toFixed(1) + ',100%,58%,0.55)');
    }
    var endT = Math.min(0.999, span / TAU);
    g.addColorStop(endT, 'hsla(0,100%,58%,0)');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, W, H);
  }

  function drawPrism(G) {
    var T = G.T, BR = G.BR, BL = G.BL;
    var ox = 8, oy = 6;

    ctx.globalCompositeOperation = 'source-over';

    // 背面（错位一点，形成厚度感）
    ctx.beginPath();
    ctx.moveTo(T.x + ox, T.y + oy);
    ctx.lineTo(BR.x + ox, BR.y + oy);
    ctx.lineTo(BL.x + ox, BL.y + oy);
    ctx.closePath();
    ctx.fillStyle = 'rgba(110,145,200,.13)';
    ctx.fill();

    // 正面
    ctx.beginPath();
    ctx.moveTo(T.x, T.y);
    ctx.lineTo(BR.x, BR.y);
    ctx.lineTo(BL.x, BL.y);
    ctx.closePath();
    var pg = ctx.createLinearGradient(BL.x, T.y, BR.x, BR.y);
    pg.addColorStop(0, 'rgba(20,26,40,.88)');
    pg.addColorStop(0.42, 'rgba(8,11,19,.92)');
    pg.addColorStop(0.78, 'rgba(16,22,36,.90)');
    pg.addColorStop(1, 'rgba(30,40,62,.84)');
    ctx.fillStyle = pg;
    ctx.fill();

    // 内壁反光（左下往上的斜条）
    ctx.save();
    ctx.beginPath();
    ctx.moveTo(T.x, T.y);
    ctx.lineTo(BR.x, BR.y);
    ctx.lineTo(BL.x, BL.y);
    ctx.closePath();
    ctx.clip();
    var ig = ctx.createLinearGradient(BL.x, BL.y, T.x, BR.y);
    ig.addColorStop(0, 'rgba(120,160,220,.16)');
    ig.addColorStop(0.35, 'rgba(120,160,220,0)');
    ctx.fillStyle = ig;
    ctx.fillRect(BL.x, T.y, G.S * 1.6, G.S * 1.4);
    ctx.restore();

    // 三条边
    ctx.strokeStyle = 'rgba(170,200,240,.34)';
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(T.x, T.y); ctx.lineTo(BR.x, BR.y);
    ctx.lineTo(BL.x, BL.y); ctx.closePath();
    ctx.stroke();

    // 受光边（右面）最亮
    ctx.strokeStyle = 'rgba(255,255,255,.95)';
    ctx.lineWidth = 2.3;
    seg(T, BR);

    // 底边与左边缘
    ctx.strokeStyle = 'rgba(215,235,255,.55)';
    ctx.lineWidth = 1.5;
    seg(BR, BL);
    ctx.strokeStyle = 'rgba(190,220,255,.62)';
    ctx.lineWidth = 1.7;
    seg(BL, T);
  }

  function draw(now) {
    if (!W) return;
    var G = geom();

    var f = ((cur % 3) + 3) % 3;
    var i0 = Math.floor(f) % 3, i1 = (i0 + 1) % 3, k = f - Math.floor(f);
    var theta = angles[i0] + (angles[i1] - angles[i0]) * k;

    var E = lerp(G.T, G.BR, 0.5);
    var nIn = norm(sub(G.C, E));
    var d = rot(nIn, theta);
    var start = sub(E, mul(d, 1100));

    var mid = exitInfo(G, E, d, 550);
    var red = exitInfo(G, E, d, 700);
    var vio = exitInfo(G, E, d, 400);

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);
    ctx.globalCompositeOperation = 'lighter';
    ctx.lineCap = 'round';

    // 入射光：发光管
    ctx.filter = 'blur(16px)';
    ctx.strokeStyle = 'rgba(255,255,255,.55)';
    ctx.lineWidth = 30;
    seg(start, E);
    ctx.filter = 'blur(6px)';
    ctx.strokeStyle = 'rgba(255,255,255,.85)';
    ctx.lineWidth = 11;
    seg(start, E);
    ctx.filter = 'none';
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 3.6;
    seg(start, E);

    // 棱镜内部（白偏冷）
    if (mid && mid.inner.length) {
      ctx.filter = 'blur(7px)';
      ctx.strokeStyle = 'rgba(230,240,255,.55)';
      ctx.lineWidth = 9;
      for (var s1 = 0; s1 < mid.inner.length; s1++) seg(mid.inner[s1].a, mid.inner[s1].b);
      ctx.filter = 'none';
      ctx.strokeStyle = 'rgba(245,250,255,.9)';
      ctx.lineWidth = 2.4;
      for (var s2 = 0; s2 < mid.inner.length; s2++) seg(mid.inner[s2].a, mid.inner[s2].b);
    }

    // 连续光谱扇
    if (red && vio && mid) {
      var a0 = Math.atan2(red.exit.d.y, red.exit.d.x);
      var a1 = Math.atan2(vio.exit.d.y, vio.exit.d.x);
      while (a1 - a0 > Math.PI) a1 -= Math.PI * 2;
      while (a0 - a1 > Math.PI) a1 += Math.PI * 2;
      var lo = Math.min(a0, a1), hi = Math.max(a0, a1);
      var span = Math.max(0.055, hi - lo);
      var redAtLo = (a0 <= a1);

      ctx.filter = 'blur(26px)';
      drawFan(mid.exit.p, lo, span, redAtLo);
      ctx.filter = 'blur(9px)';
      drawFan(mid.exit.p, lo, span, redAtLo);
      ctx.filter = 'none';
      drawFan(mid.exit.p, lo, span, redAtLo);

      // 出射点光斑
      var gg = ctx.createRadialGradient(mid.exit.p.x, mid.exit.p.y, 0, mid.exit.p.x, mid.exit.p.y, G.S * 0.55);
      gg.addColorStop(0, 'rgba(255,255,255,.85)');
      gg.addColorStop(0.3, 'rgba(210,230,255,.22)');
      gg.addColorStop(1, 'rgba(210,230,255,0)');
      ctx.fillStyle = gg;
      ctx.beginPath();
      ctx.arc(mid.exit.p.x, mid.exit.p.y, G.S * 0.55, 0, 6.2832);
      ctx.fill();
    }

    drawPrism(G);
  }

  var lastDraw = 0;
  function tick(now) {
    requestAnimationFrame(tick);
    if (now - lastDraw < 33) return;
    lastDraw = now;
    cur += (target - cur) * 0.09;
    if (Math.abs(target - cur) < 0.0015) cur = target;
    draw(now);
  }

  function setActive(i) {
    target = i;
    var on = ((i % 3) + 3) % 3;
    for (var k2 = 0; k2 < stats.length; k2++) stats[k2].classList.toggle('on', k2 === on);
  }

  resize();
  setActive(0);

  if (reduce) { draw(performance.now()); return; }

  requestAnimationFrame(tick);
  draw(performance.now());

  var step = 0;
  setInterval(function () {
    if (document.hidden) return;
    step++;
    setActive(step);
  }, 3600);

  var rt = null;
  window.addEventListener('resize', function () {
    clearTimeout(rt);
    rt = setTimeout(function () { resize(); draw(performance.now()); }, 140);
  });
})();

/* ============================================================
   交互升级：列表逐条入场 + 顶栏滚动阴影
   ============================================================ */
(function uiPolish() {
  var lists = ['listWork', 'listTalk', 'listMem', 'listTeam', 'listDoc', 'listHist'];
  lists.forEach(function (id) {
    var el = document.getElementById(id);
    if (!el || !window.MutationObserver) return;
    new MutationObserver(function () {
      var kids = el.children;
      for (var i = 0; i < kids.length && i < 10; i++) {
        var k = kids[i];
        k.style.animation = 'none';
        void k.offsetWidth;
        k.style.animation = 'staggerIn .3s ease both';
        k.style.animationDelay = (i * 40) + 'ms';
      }
    }).observe(el, { childList: true });
  });

  var pages = document.getElementById('pages');
  var bar = document.querySelector('.topbar');
  if (pages && bar) {
    pages.addEventListener('scroll', function () {
      bar.classList.toggle('scrolled', pages.scrollTop > 6);
    }, { passive: true });
  }
})();

/* ============================================================
   PWA：注册 Service Worker（只在 HTTPS 下生效，本地 file:// 会跳过）
   ============================================================ */
if ('serviceWorker' in navigator && location.protocol === 'https:') {
  window.addEventListener('load', function () {
    navigator.serviceWorker.register('sw.js').catch(function () {});
  });
}

/* ============================================================
   个人中心
   ============================================================ */
var editRole = '成员';
var editSkills = [];

function meDefaults() {
  if (!member.av) member.av = 'lin';
  if (!member.skills) member.skills = [];
  if (!member.can) member.can = '—';
  if (!member.need) member.need = '—';
  return member;
}

function persistMember() {
  try { localStorage.setItem('iea_member', JSON.stringify(member)); } catch (e) {}
}

function openMe() {
  meDefaults();
  var applied = (S.applied || []).length;

  var h = '<div class="member" style="margin:0 0 14px">' +
    '<div class="top">' +
      '<div class="av" style="background:' + avStyle(member.av) + '">' + esc(member.name.charAt(0)) + '</div>' +
      '<div><b>' + esc(member.name) + '</b>' +
      '<span>' + esc(member.cohort || '') + ' 级 · ' + esc(member.major || '') + ' · ' + esc(member.role || '成员') + '</span></div>' +
    '</div>' +
    '<div class="kv"><span>学号</span><b>' + esc(member.sid || '—') + '</b></div>' +
    '<div class="kv"><span>绑定手机</span><b>' + esc(member.phone || '—') + '</b></div>' +
    '<div class="kv"><span>我的帖子</span><b>' + S.userPosts.length + ' 条</b></div>' +
    '<div class="kv"><span>点赞过</span><b>' + S.liked.length + ' 条</b></div>' +
    '<div class="kv"><span>申请团队</span><b>' + applied + ' 个</b></div>' +
  '</div>';

  if (member.skills.length) {
    h += '<div class="dsec" style="margin-top:0">技能标签</div><div class="dmember">' +
      member.skills.map(function (s) { return '<span>' + esc(s) + '</span>'; }).join('') +
      '</div>';
  }

  h += '<div class="give" style="margin:14px 0 16px">' +
    '<div class="can"><b>可提供</b>' + esc(member.can) + '</div>' +
    '<div class="need"><b>需要</b>' + esc(member.need) + '</div>' +
  '</div>';

  var mp = myProjects();
  h += '<div class="dsec" style="margin-top:4px">我的项目经历</div>';
  if (mp.length) {
    h += mp.map(function (p) {
      return '<div class="mini" style="margin:0 0 8px" onclick="closeSheet();setTimeout(function(){openProject(\'' + p.id + '\')},240)">' +
        '<div class="mico" style="background:' + p.cover + '">' + p.emoji + '</div>' +
        '<div class="mt"><b>' + esc(p.t) + '</b><span>' + p.y + ' · ' + esc(p.award) + '</span></div>' +
      '</div>';
    }).join('');
    h += '<button class="ghostbtn" style="color:var(--brand);border-color:#c9cbff;background:#f3f4ff;margin-bottom:10px" onclick="copyAllResume()">复制全部经历到简历</button>';
  } else {
    h += '<div class="empty" style="padding:16px 0 22px">还没有关联的项目<br>项目卡里写上你的名字就会出现在这里</div>';
  }

  h += '<button class="gate-btn" onclick="openEditMe()">编辑资料</button>';
  h += '<button class="ghostbtn" onclick="location.href=\'download.html\'">下载安卓 App</button>';
  h += '<button class="ghostbtn" onclick="logout()">退出登录</button>';

  $('sheetTitle').textContent = '个人中心';
  $('sheetBody').innerHTML = h;
  openSheet();
}

function openEditMe() {
  meDefaults();
  editRole = member.role || '成员';
  editSkills = member.skills.slice();

  var colors = ['lin', 'chen', 'su', 'wang', 'li', 'zhao', 'zhou'];
  var roles = ['成员', '部长', '会长', '指导教师', '校友'];

  var h = '<div class="dsec" style="margin-top:0">头像颜色</div><div class="pickcolors">' +
    colors.map(function (k) {
      return '<button class="pc' + (k === member.av ? ' on' : '') + '" data-k="' + k +
        '" style="background:' + avStyle(k) + '" onclick="pickColor(this)"></button>';
    }).join('') + '</div>';

  h += '<div class="editfield"><label>姓名</label>' +
    '<input id="eName" class="gate-inp" maxlength="12" value="' + esc(member.name) + '"></div>';

  h += '<div class="editfield"><label>年级</label>' +
    '<input id="eCohort" class="gate-inp" maxlength="6" value="' + esc(member.cohort) + '" placeholder="如 2023"></div>';

  h += '<div class="editfield"><label>学院 / 专业</label>' +
    '<input id="eMajor" class="gate-inp" maxlength="30" value="' + esc(member.major) +
    '" placeholder="如 水利工程学院 · 水利水电建筑工程"></div>';

  h += '<div class="editfield"><label>身份</label><div class="pickroles" id="rolePick">' +
    roles.map(function (r) {
      return '<button data-r="' + r + '" class="' + (r === editRole ? 'on' : '') +
        '" onclick="pickRole(this, \'' + r + '\')">' + r + '</button>';
    }).join('') + '</div></div>';

  h += '<div class="dsec">技能标签</div>' +
    '<div class="skillrow"><input id="eSkill" class="gate-inp" placeholder="输入技能，如 CAD / 建模">' +
    '<button class="addbtn" onclick="addSkill()">添加</button></div>' +
    '<div id="skillList" style="margin-bottom:6px"></div>';

  h += '<div class="editfield"><label>我能提供</label>' +
    '<input id="eCan" class="gate-inp" maxlength="40" value="' + esc(member.can) + '"></div>';

  h += '<div class="editfield"><label>我需要</label>' +
    '<input id="eNeed" class="gate-inp" maxlength="40" value="' + esc(member.need) + '"></div>';

  h += '<button class="gate-btn" style="margin-top:16px" onclick="saveMe()">保存</button>';
  h += '<button class="ghostbtn" onclick="openMe()">取消</button>';

  $('sheetTitle').textContent = '编辑资料';
  $('sheetBody').innerHTML = h;
  renderSkills();
  openSheet();
}

function pickColor(el) {
  var k = el.getAttribute('data-k');
  var all = document.querySelectorAll('.pc');
  for (var i = 0; i < all.length; i++) all[i].classList.remove('on');
  el.classList.add('on');
  member.av = k;
}

function pickRole(el, r) {
  editRole = r;
  var btns = document.querySelectorAll('#rolePick button');
  for (var i = 0; i < btns.length; i++) {
    btns[i].classList.toggle('on', btns[i].getAttribute('data-r') === r);
  }
}

function renderSkills() {
  var el = $('skillList');
  if (!el) return;
  el.innerHTML = editSkills.length
    ? editSkills.map(function (s, i) {
        return '<span class="skillchip" onclick="removeSkill(' + i + ')">' + esc(s) + ' ×</span>';
      }).join('')
    : '<span style="font-size:11px;color:var(--ink3)">还没有技能标签，加 2~3 个更容易被队友找到</span>';
}

function addSkill() {
  var inp = $('eSkill');
  var v = inp.value.trim();
  if (!v) return toast('先输入技能名称');
  if (editSkills.indexOf(v) >= 0) return toast('这个技能已经加过了');
  if (editSkills.length >= 8) return toast('最多 8 个技能');
  editSkills.push(v);
  inp.value = '';
  renderSkills();
}

function removeSkill(i) {
  editSkills.splice(i, 1);
  renderSkills();
}

function saveMe() {
  var name = $('eName').value.trim();
  if (name.length < 2) return toast('姓名至少 2 个字');

  member.name = name;
  member.cohort = $('eCohort').value.trim() || '—';
  member.major = $('eMajor').value.trim() || '—';
  member.role = editRole;
  member.skills = editSkills.slice();
  member.can = $('eCan').value.trim() || '—';
  member.need = $('eNeed').value.trim() || '—';
  persistMember();

  $('meAv').textContent = member.name.charAt(0);
  $('meAv').style.background = avStyle(member.av);
  $('meName').textContent = member.name;
  $('hiText').textContent = '你好，' + member.name + ' · ' + (member.cohort || '') + ' 级';

  toast('资料已保存');
  openMe();
}

function logout() {
  localStorage.removeItem('iea_member');
  localStorage.removeItem('iea_token');
  closeSheet();
  toast('已退出，正在返回登录…');
  setTimeout(function () { location.reload(); }, 600);
}
</script>
</body>
</html>
