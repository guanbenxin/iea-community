    members:[ {n:'赵敏',r:'负责人',s:'新材料'}, {n:'周明',r:'施工',s:'测量'},
              {n:'林小满',r:'数据',s:'统计'}, {n:'王砚',r:'方案',s:'报告'},
              {n:'苏晴',r:'图纸',s:'制图'} ],
    projects:['p4'] },

